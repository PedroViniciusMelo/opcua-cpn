                  <id>nodeId</id>
                  <id>NODE_ID</id>
                </recordfield>
                <recordfield>
                  <id>attributeId</id>
                  <id>ATTRIBUTE_ID</id>
                </recordfield>
              </record>
              <layout>colset READ_VALUE_ID = record nodeId: NODE_ID * attributeId: ATTRIBUTE_ID;
(* ReadValueId -- Parte 4 7.28 (indexRange/dataEncoding omitidos) *)</layout>
            </color>
            <color id="ID95000033">
              <id>WRITE_VALUE</id>
              <record>
