                  <id>FIND_SERVERS_REQ</id>
                </type>
              </unionfield>
              <unionfield>
                <id>FindServersResp</id>
                <type>
                  <id>FIND_SERVERS_RESP</id>
                </type>
              </unionfield>
              <unionfield>
                <id>GetEndpointsReq</id>
                <type>
                  <id>GET_ENDPOINTS_REQ</id>
                </type>
              </unionfield>
              <unionfield>
                <id>GetEndpointsResp</id>
                <type>
                  <id>GET_ENDPOINTS_RESP</id>
                </type>
              </unionfield>
              <unionfield>
                <id>AddressSpaceReq</id>
                <type>
                  <id>AS_SERVICE_REQ</id>
                </type>
              </unionfield>
              <unionfield>
                <id>AddressSpaceResp</id>
                <type>
                  <id>AS_SERVICE_RESP</id>
                </type>
              </unionfield>
            </union>
            <layout>colset MSG_BODY =
  union OpenChannelReq    : OPEN_CHANNEL_REQ +
        OpenChannelResp   : OPEN_CHANNEL_RESP +
        CreateSessionReq  : CREATE_SESSION_REQ +
        CreateSessionResp : CREATE_SESSION_RESP +
        ActivateReq       : ACTIVATE_SESSION_REQ +
        ActivateResp      : ACTIVATE_SESSION_RESP +
        OtherServiceReq   : SERVICE_REQ +
        OtherServiceResp  : SERVICE_RESP +
        CloseChannelReq   : CLOSE_CHANNEL_REQ +
        CloseSessionReq   : CLOSE_SESSION_REQ +
        CloseSessionResp  : CLOSE_SESSION_RESP +
        RegisterServerReq  : REGISTER_SERVER_REQ +
        RegisterServerResp : REGISTER_SERVER_RESP +
        FindServersReq      : FIND_SERVERS_REQ +
        FindServersResp     : FIND_SERVERS_RESP +
        GetEndpointsReq     : GET_ENDPOINTS_REQ +
        GetEndpointsResp    : GET_ENDPOINTS_RESP +
        AddressSpaceReq     : AS_SERVICE_REQ +
        AddressSpaceResp    : AS_SERVICE_RESP;</layout>
          </color>
