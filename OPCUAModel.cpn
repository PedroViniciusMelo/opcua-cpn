          <ml id="ID95000087">(* No combinado: uma unica identidade (Server2Id) exerce os dois papeis.
   O modulo ClientServerApp reutiliza 100% ClientApp e ServerApp; aqui so
   fornecemos as duas configuracoes com o MESMO myId -- Parte 4/Parte 2 4.5.2 *)
val cs2ServerConfig = 1`{myId=Server2Id,
trustList=[TrustsClient1,TrustsClient2],
supportedPolicies=[PolicyNoneUnsupported,PolicyBasic256FullySupported,PolicyAES256Supported],
maxCapacity=10,
addressSpace=boilerAddressSpace, roleMappings=serverRoleMappings}
            <layout>(* No combinado: uma unica identidade (Server2Id) exerce os dois papeis.
   O modulo ClientServerApp reutiliza 100% ClientApp e ServerApp; aqui so
   fornecemos as duas configuracoes com o MESMO myId -- Parte 4/Parte 2 4.5.2 *)
val cs2ServerConfig = 1`{myId=Server2Id,
trustList=[TrustsClient1,TrustsClient2],
supportedPolicies=[PolicyNoneUnsupported,PolicyBasic256FullySupported,PolicyAES256Supported],
maxCapacity=10,
addressSpace=boilerAddressSpace, roleMappings=serverRoleMappings}</layout>
          </ml>
          <ml id="ID95000088">val cs2ClientConfig = 1`{myId=Server2Id,
trustList=[TrustsServer1],
preferredConfigs=[{server=Server1Id,configs=[CfgBasic256Enc]}],
serversToContact=[Server1Id],
plannedOperations=[{server=Server1Id,
                    request=ReadRequest {nodeId=TemperatureId, attributeId=AT_VALUE}}]}
(* como cliente, o no combinado le a Temperature do Server1 *)
            <layout>val cs2ClientConfig = 1`{myId=Server2Id,
trustList=[TrustsServer1],
preferredConfigs=[{server=Server1Id,configs=[CfgBasic256Enc]}],
serversToContact=[Server1Id],
plannedOperations=[{server=Server1Id,
                    request=ReadRequest {nodeId=TemperatureId, attributeId=AT_VALUE}}]}
(* como cliente, o no combinado le a Temperature do Server1 *)</layout>
          </ml>
        </block>
      </block>
