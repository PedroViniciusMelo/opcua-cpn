            <ml id="ID1446449449">val NoPerm : PERMISSION = {browse=false, read=false, write=false, call=false};
              <layout>val NoPerm : PERMISSION = {browse=false, read=false, write=false, call=false};</layout>
            </ml>
            <ml id="ID95000029">fun roleConcat ([]:ROLE_LIST, ys) = ys
  | roleConcat (x::xs, ys) = x :: roleConcat (xs, ys);

fun findNode (nid:NODE_ID, nodes:AS_NODE_LIST) =
  List.find (fn (n:AS_NODE) =&gt; #nodeId n = nid) nodes;

fun nodeClassOf (n:AS_NODE) : NODE_CLASS =
  case #nodeBody n of
      ObjectNode _   =&gt; NC_OBJECT
    | VariableNode _ =&gt; NC_VARIABLE
    | MethodNode _   =&gt; NC_METHOD;

fun nodeClassCode NC_OBJECT   = 1
  | nodeClassCode NC_VARIABLE = 2
  | nodeClassCode NC_METHOD   = 4;


fun dataTypeNodeId DT_BOOLEAN = &quot;i=1&quot;
  | dataTypeNodeId DT_INT32   = &quot;i=6&quot;
  | dataTypeNodeId DT_STRING  = &quot;i=12&quot;;

fun accessLevelByte (al:ACCESS_LEVEL) : INT =
  (if #currentRead al then 1 else 0) + (if #currentWrite al then 2 else 0);

fun attributeValid (nc:NODE_CLASS, a:ATTRIBUTE_ID) : bool =
  case a of
      AT_NODE_ID           =&gt; true
    | AT_NODE_CLASS        =&gt; true
    | AT_BROWSE_NAME       =&gt; true
    | AT_DISPLAY_NAME      =&gt; true
    | AT_VALUE             =&gt; nc = NC_VARIABLE
    | AT_DATA_TYPE         =&gt; nc = NC_VARIABLE
    | AT_ACCESS_LEVEL      =&gt; nc = NC_VARIABLE
    | AT_USER_ACCESS_LEVEL =&gt; nc = NC_VARIABLE
    | AT_EXECUTABLE        =&gt; nc = NC_METHOD
    | AT_USER_EXECUTABLE   =&gt; nc = NC_METHOD;


fun restrictionsMet (ar:ACCESS_RESTRICTIONS, (_,mode):SECURITY_CONFIG, isBrowse:bool) : bool =
  (isBrowse andalso not (#applyRestrictionsToBrowse ar)) orelse
  ((not (#signingRequired ar) orelse mode &lt;&gt; SM_NONE) andalso
   (not (#encryptionRequired ar) orelse mode = SIGN_AND_ENCRYPT));

fun typeMatches (VBoolean _, DT_BOOLEAN) = true
  | typeMatches (VInt32 _,   DT_INT32)   = true
  | typeMatches (VString _,  DT_STRING)  = true
  | typeMatches _ = false;

fun readAttribute (n:AS_NODE, a:ATTRIBUTE_ID) : VARIANT =
  case (a, #nodeBody n) of
      (AT_NODE_ID, _)                     =&gt; VString (#nodeId n)
    | (AT_NODE_CLASS, _)                  =&gt; VInt32 (nodeClassCode (nodeClassOf n))
    | (AT_BROWSE_NAME, _)                 =&gt; VString (#browseName n)
    | (AT_DISPLAY_NAME, _)                =&gt; VString (#browseName n)
    | (AT_VALUE, VariableNode v)          =&gt; #value v
    | (AT_DATA_TYPE, VariableNode v)      =&gt; VString (dataTypeNodeId (#dataType v))
    | (AT_ACCESS_LEVEL, VariableNode v)   =&gt; VInt32 (accessLevelByte (#accessLevel v))
    | (AT_USER_ACCESS_LEVEL, VariableNode v) =&gt; VInt32 (accessLevelByte (#userAccessLevel v))
    | (AT_EXECUTABLE, MethodNode m)       =&gt; VBoolean (#executable m)
    | (AT_USER_EXECUTABLE, MethodNode m)  =&gt; VBoolean (#userExecutable m)
    | _ =&gt; VNull ();

fun replaceValue (n:AS_NODE, v:VARIANT) : AS_NODE =
  case #nodeBody n of
      VariableNode va =&gt;
        {nodeId = #nodeId n, browseName = #browseName n,
         accessRestrictions = #accessRestrictions n, rolePermissions = #rolePermissions n,
         references = #references n,
         nodeBody = VariableNode {value = v, dataType = #dataType va,
                                  accessLevel = #accessLevel va,
                                  userAccessLevel = #userAccessLevel va}}
    | _ =&gt; n;

fun setValue (nodes:AS_NODE_LIST, nid:NODE_ID, v:VARIANT) : AS_NODE_LIST =
  List.map (fn (n:AS_NODE) =&gt; if #nodeId n = nid then replaceValue (n, v) else n) nodes;

fun permOr (a:PERMISSION, b:PERMISSION) : PERMISSION =
  {browse = #browse a orelse #browse b, read = #read a orelse #read b,
   write = #write a orelse #write b, call = #call a orelse #call b};

fun roleGranted (rid:ROLE, roles:ROLE_LIST) : bool =
  List.exists (fn r =&gt; r = rid) roles;

fun mappedRoles (client:APP_ID, []:ROLE_MAPPING_LIST) : ROLE_LIST = []
  | mappedRoles (client, m::ms) =
      if #identity m = client then #roles m else mappedRoles (client, ms);


fun sessionRoles (client:APP_ID, (_,mode):SECURITY_CONFIG, rmaps:ROLE_MAPPING_LIST) : ROLE_LIST =
  Anonymous ::
  roleConcat ((if mode &lt;&gt; SM_NONE then [TrustedApplication] else []), mappedRoles (client, rmaps));


fun accPermission ([]:ROLE_PERMISSION_LIST, roles:ROLE_LIST, p:PERMISSION) : PERMISSION = p
  | accPermission (rp::rest, roles, p) =
      if roleGranted (#roleId rp, roles) then accPermission (rest, roles, permOr (#permissions rp, p))
      else accPermission (rest, roles, p);

fun effectivePermission (n:AS_NODE, roles:ROLE_LIST) : PERMISSION =
  accPermission (#rolePermissions n, roles, NoPerm);

fun rbacEnforced (n:AS_NODE) : bool = #rolePermissions n &lt;&gt; [];

fun mayBrowse (n:AS_NODE, roles:ROLE_LIST) : bool =
  not (rbacEnforced n) orelse #browse (effectivePermission (n, roles));

fun mayRead (n:AS_NODE, roles:ROLE_LIST) : bool =
  not (rbacEnforced n) orelse #read (effectivePermission (n, roles));

fun mayWrite (n:AS_NODE, roles:ROLE_LIST) : bool =
  not (rbacEnforced n) orelse #write (effectivePermission (n, roles));

fun mayCall (n:AS_NODE, roles:ROLE_LIST) : bool =
  not (rbacEnforced n) orelse #call (effectivePermission (n, roles));
              <layout>fun roleConcat ([]:ROLE_LIST, ys) = ys
  | roleConcat (x::xs, ys) = x :: roleConcat (xs, ys);

fun findNode (nid:NODE_ID, nodes:AS_NODE_LIST) =
  List.find (fn (n:AS_NODE) =&gt; #nodeId n = nid) nodes;

fun nodeClassOf (n:AS_NODE) : NODE_CLASS =
  case #nodeBody n of
      ObjectNode _   =&gt; NC_OBJECT
    | VariableNode _ =&gt; NC_VARIABLE
    | MethodNode _   =&gt; NC_METHOD;

fun nodeClassCode NC_OBJECT   = 1
  | nodeClassCode NC_VARIABLE = 2
  | nodeClassCode NC_METHOD   = 4;


fun dataTypeNodeId DT_BOOLEAN = &quot;i=1&quot;
  | dataTypeNodeId DT_INT32   = &quot;i=6&quot;
  | dataTypeNodeId DT_STRING  = &quot;i=12&quot;;

fun accessLevelByte (al:ACCESS_LEVEL) : INT =
  (if #currentRead al then 1 else 0) + (if #currentWrite al then 2 else 0);

fun attributeValid (nc:NODE_CLASS, a:ATTRIBUTE_ID) : bool =
  case a of
      AT_NODE_ID           =&gt; true
    | AT_NODE_CLASS        =&gt; true
    | AT_BROWSE_NAME       =&gt; true
    | AT_DISPLAY_NAME      =&gt; true
    | AT_VALUE             =&gt; nc = NC_VARIABLE
    | AT_DATA_TYPE         =&gt; nc = NC_VARIABLE
    | AT_ACCESS_LEVEL      =&gt; nc = NC_VARIABLE
    | AT_USER_ACCESS_LEVEL =&gt; nc = NC_VARIABLE
    | AT_EXECUTABLE        =&gt; nc = NC_METHOD
    | AT_USER_EXECUTABLE   =&gt; nc = NC_METHOD;


fun restrictionsMet (ar:ACCESS_RESTRICTIONS, (_,mode):SECURITY_CONFIG, isBrowse:bool) : bool =
  (isBrowse andalso not (#applyRestrictionsToBrowse ar)) orelse
  ((not (#signingRequired ar) orelse mode &lt;&gt; SM_NONE) andalso
   (not (#encryptionRequired ar) orelse mode = SIGN_AND_ENCRYPT));

fun typeMatches (VBoolean _, DT_BOOLEAN) = true
  | typeMatches (VInt32 _,   DT_INT32)   = true
  | typeMatches (VString _,  DT_STRING)  = true
  | typeMatches _ = false;

fun readAttribute (n:AS_NODE, a:ATTRIBUTE_ID) : VARIANT =
  case (a, #nodeBody n) of
      (AT_NODE_ID, _)                     =&gt; VString (#nodeId n)
    | (AT_NODE_CLASS, _)                  =&gt; VInt32 (nodeClassCode (nodeClassOf n))
    | (AT_BROWSE_NAME, _)                 =&gt; VString (#browseName n)
    | (AT_DISPLAY_NAME, _)                =&gt; VString (#browseName n)
    | (AT_VALUE, VariableNode v)          =&gt; #value v
    | (AT_DATA_TYPE, VariableNode v)      =&gt; VString (dataTypeNodeId (#dataType v))
    | (AT_ACCESS_LEVEL, VariableNode v)   =&gt; VInt32 (accessLevelByte (#accessLevel v))
    | (AT_USER_ACCESS_LEVEL, VariableNode v) =&gt; VInt32 (accessLevelByte (#userAccessLevel v))
    | (AT_EXECUTABLE, MethodNode m)       =&gt; VBoolean (#executable m)
    | (AT_USER_EXECUTABLE, MethodNode m)  =&gt; VBoolean (#userExecutable m)
    | _ =&gt; VNull ();

fun replaceValue (n:AS_NODE, v:VARIANT) : AS_NODE =
  case #nodeBody n of
      VariableNode va =&gt;
        {nodeId = #nodeId n, browseName = #browseName n,
         accessRestrictions = #accessRestrictions n, rolePermissions = #rolePermissions n,
         references = #references n,
         nodeBody = VariableNode {value = v, dataType = #dataType va,
                                  accessLevel = #accessLevel va,
                                  userAccessLevel = #userAccessLevel va}}
    | _ =&gt; n;

fun setValue (nodes:AS_NODE_LIST, nid:NODE_ID, v:VARIANT) : AS_NODE_LIST =
  List.map (fn (n:AS_NODE) =&gt; if #nodeId n = nid then replaceValue (n, v) else n) nodes;

fun permOr (a:PERMISSION, b:PERMISSION) : PERMISSION =
  {browse = #browse a orelse #browse b, read = #read a orelse #read b,
   write = #write a orelse #write b, call = #call a orelse #call b};

fun roleGranted (rid:ROLE, roles:ROLE_LIST) : bool =
  List.exists (fn r =&gt; r = rid) roles;

fun mappedRoles (client:APP_ID, []:ROLE_MAPPING_LIST) : ROLE_LIST = []
  | mappedRoles (client, m::ms) =
      if #identity m = client then #roles m else mappedRoles (client, ms);


fun sessionRoles (client:APP_ID, (_,mode):SECURITY_CONFIG, rmaps:ROLE_MAPPING_LIST) : ROLE_LIST =
  Anonymous ::
  roleConcat ((if mode &lt;&gt; SM_NONE then [TrustedApplication] else []), mappedRoles (client, rmaps));


fun accPermission ([]:ROLE_PERMISSION_LIST, roles:ROLE_LIST, p:PERMISSION) : PERMISSION = p
  | accPermission (rp::rest, roles, p) =
      if roleGranted (#roleId rp, roles) then accPermission (rest, roles, permOr (#permissions rp, p))
      else accPermission (rest, roles, p);

fun effectivePermission (n:AS_NODE, roles:ROLE_LIST) : PERMISSION =
  accPermission (#rolePermissions n, roles, NoPerm);

fun rbacEnforced (n:AS_NODE) : bool = #rolePermissions n &lt;&gt; [];

fun mayBrowse (n:AS_NODE, roles:ROLE_LIST) : bool =
  not (rbacEnforced n) orelse #browse (effectivePermission (n, roles));

fun mayRead (n:AS_NODE, roles:ROLE_LIST) : bool =
  not (rbacEnforced n) orelse #read (effectivePermission (n, roles));

fun mayWrite (n:AS_NODE, roles:ROLE_LIST) : bool =
  not (rbacEnforced n) orelse #write (effectivePermission (n, roles));

fun mayCall (n:AS_NODE, roles:ROLE_LIST) : bool =
  not (rbacEnforced n) orelse #call (effectivePermission (n, roles));</layout>
            </ml>
            <ml id="ID95000030">fun restrictAccess (al:ACCESS_LEVEL, ual:ACCESS_LEVEL) : ACCESS_LEVEL =
  {currentRead  = #currentRead al andalso #currentRead ual,
   currentWrite = #currentWrite al andalso #currentWrite ual};

fun objectNode (nid:NODE_ID, name:STRING, rperms:ROLE_PERMISSION_LIST, refs:REFERENCE_LIST) : AS_NODE =
  {nodeId = nid, browseName = name,
   accessRestrictions = {signingRequired=false, encryptionRequired=false, applyRestrictionsToBrowse=false},
   rolePermissions = rperms, references = refs, nodeBody = ObjectNode ()};

fun variableNode (nid:NODE_ID, name:STRING, ar:ACCESS_RESTRICTIONS, rperms:ROLE_PERMISSION_LIST,
                  dt:DATA_TYPE, v:VARIANT, al:ACCESS_LEVEL, ual:ACCESS_LEVEL) : AS_NODE =
  {nodeId = nid, browseName = name, accessRestrictions = ar, rolePermissions = rperms, references = [],
   nodeBody = VariableNode {value = v, dataType = dt, accessLevel = al,
                            userAccessLevel = restrictAccess (al, ual)}};
fun methodNode (nid:NODE_ID, name:STRING, ar:ACCESS_RESTRICTIONS, rperms:ROLE_PERMISSION_LIST,
                exe:bool, uexe:bool, ins:DATA_TYPE_LIST, outs:DATA_TYPE_LIST, eff:METHOD_EFFECT) : AS_NODE =
  {nodeId = nid, browseName = name, accessRestrictions = ar, rolePermissions = rperms, references = [],
   nodeBody = MethodNode {executable = exe, userExecutable = exe andalso uexe,
                          inputArguments = ins, outputArguments = outs, effect = eff}};

fun hasComponentRef (nid:NODE_ID) : REFERENCE = {referenceTypeId = RT_HAS_COMPONENT, targetId = nid};

fun hasPropertyRef  (nid:NODE_ID) : REFERENCE = {referenceTypeId = RT_HAS_PROPERTY,  targetId = nid};

fun organizesRef    (nid:NODE_ID) : REFERENCE = {referenceTypeId = RT_ORGANIZES,     targetId = nid};

fun rp (r:ROLE, p:PERMISSION) : ROLE_PERMISSION = {roleId = r, permissions = p};
              <layout>fun restrictAccess (al:ACCESS_LEVEL, ual:ACCESS_LEVEL) : ACCESS_LEVEL =
  {currentRead  = #currentRead al andalso #currentRead ual,
   currentWrite = #currentWrite al andalso #currentWrite ual};

fun objectNode (nid:NODE_ID, name:STRING, rperms:ROLE_PERMISSION_LIST, refs:REFERENCE_LIST) : AS_NODE =
  {nodeId = nid, browseName = name,
   accessRestrictions = {signingRequired=false, encryptionRequired=false, applyRestrictionsToBrowse=false},
   rolePermissions = rperms, references = refs, nodeBody = ObjectNode ()};

fun variableNode (nid:NODE_ID, name:STRING, ar:ACCESS_RESTRICTIONS, rperms:ROLE_PERMISSION_LIST,
                  dt:DATA_TYPE, v:VARIANT, al:ACCESS_LEVEL, ual:ACCESS_LEVEL) : AS_NODE =
  {nodeId = nid, browseName = name, accessRestrictions = ar, rolePermissions = rperms, references = [],
   nodeBody = VariableNode {value = v, dataType = dt, accessLevel = al,
                            userAccessLevel = restrictAccess (al, ual)}};
fun methodNode (nid:NODE_ID, name:STRING, ar:ACCESS_RESTRICTIONS, rperms:ROLE_PERMISSION_LIST,
                exe:bool, uexe:bool, ins:DATA_TYPE_LIST, outs:DATA_TYPE_LIST, eff:METHOD_EFFECT) : AS_NODE =
  {nodeId = nid, browseName = name, accessRestrictions = ar, rolePermissions = rperms, references = [],
   nodeBody = MethodNode {executable = exe, userExecutable = exe andalso uexe,
                          inputArguments = ins, outputArguments = outs, effect = eff}};

fun hasComponentRef (nid:NODE_ID) : REFERENCE = {referenceTypeId = RT_HAS_COMPONENT, targetId = nid};

fun hasPropertyRef  (nid:NODE_ID) : REFERENCE = {referenceTypeId = RT_HAS_PROPERTY,  targetId = nid};

fun organizesRef    (nid:NODE_ID) : REFERENCE = {referenceTypeId = RT_ORGANIZES,     targetId = nid};

fun rp (r:ROLE, p:PERMISSION) : ROLE_PERMISSION = {roleId = r, permissions = p};</layout>
