        <block id="ID1412958017">
          <id>Builders</id>
          <ml id="ID20000125">(* ===== OpenSecureChannel / CloseSecureChannel (lado servidor) -- Parte 4 5.6, Parte 6 6.7.4 ===== *)
fun modeAllowed (m:SEC_MODE, allowed:SEC_MODE_LIST) : bool =
  List.exists (fn x =&gt; x = m) allowed;

(* custo abstrato de recursos por politica (DoS -- Parte 2 5.1.2) *)
fun policyCost POLICY_NONE            = 1
  | policyCost BASIC256SHA256        = 3
  | policyCost AES128_SHA256_RSAOAEP = 3
  | policyCost AES256_SHA256_RSAPSS  = 5
  | policyCost BASIC128RSA15         = 2
  | policyCost BASIC256              = 2;

fun channelCost (ch:SECURE_CHANNEL) : INT = policyCost (#1 (#config ch));

fun rejectReason (decision:TRUST_DECISION, modes:SEC_MODE_LIST, count:INT, max:INT) : STATUS =
  if count &gt;= max then BAD_TCP_SERVER_TOO_BUSY
  else if decision = REJECTED then BAD_CERTIFICATE_UNTRUSTED
  else if modes = [] then BAD_SECURITY_POLICY_REJECTED
  else BAD_SECURITY_MODE_REJECTED;

fun openChannelResp (me:APP_ID, cli:APP_ID, rid:INT, cid:CHANNEL_ID, cfg:SECURITY_CONFIG, st:STATUS) : NET_MSG =
  envelope(me, cli, rid,
           OpenChannelResp {channelId=cid, cert={owner=me}, config=cfg, status=st},
           applySeal(me,cfg));

fun openChannelOk (me:APP_ID, cli:APP_ID, rid:INT, cid:CHANNEL_ID, cfg:SECURITY_CONFIG) : NET_MSG =
  openChannelResp(me, cli, rid, cid, cfg, OK);

fun openChannelFault (me:APP_ID, cli:APP_ID, rid:INT, cfg:SECURITY_CONFIG, st:STATUS) : NET_MSG =
  openChannelResp(me, cli, rid, 0, cfg, st);

fun channelRejection (cli:APP_ID, st:STATUS) : CHANNEL_REJECTION =
  {client=cli, reason=st};
            <layout>(* ===== OpenSecureChannel / CloseSecureChannel (lado servidor) -- Parte 4 5.6, Parte 6 6.7.4 ===== *)
fun modeAllowed (m:SEC_MODE, allowed:SEC_MODE_LIST) : bool =
  List.exists (fn x =&gt; x = m) allowed;

(* custo abstrato de recursos por politica (DoS -- Parte 2 5.1.2) *)
fun policyCost POLICY_NONE            = 1
  | policyCost BASIC256SHA256        = 3
  | policyCost AES128_SHA256_RSAOAEP = 3
  | policyCost AES256_SHA256_RSAPSS  = 5
  | policyCost BASIC128RSA15         = 2
  | policyCost BASIC256              = 2;

fun channelCost (ch:SECURE_CHANNEL) : INT = policyCost (#1 (#config ch));

fun rejectReason (decision:TRUST_DECISION, modes:SEC_MODE_LIST, count:INT, max:INT) : STATUS =
  if count &gt;= max then BAD_TCP_SERVER_TOO_BUSY
  else if decision = REJECTED then BAD_CERTIFICATE_UNTRUSTED
  else if modes = [] then BAD_SECURITY_POLICY_REJECTED
  else BAD_SECURITY_MODE_REJECTED;

fun openChannelResp (me:APP_ID, cli:APP_ID, rid:INT, cid:CHANNEL_ID, cfg:SECURITY_CONFIG, st:STATUS) : NET_MSG =
  envelope(me, cli, rid,
           OpenChannelResp {channelId=cid, cert={owner=me}, config=cfg, status=st},
           applySeal(me,cfg));

fun openChannelOk (me:APP_ID, cli:APP_ID, rid:INT, cid:CHANNEL_ID, cfg:SECURITY_CONFIG) : NET_MSG =
  openChannelResp(me, cli, rid, cid, cfg, OK);

fun openChannelFault (me:APP_ID, cli:APP_ID, rid:INT, cfg:SECURITY_CONFIG, st:STATUS) : NET_MSG =
  openChannelResp(me, cli, rid, 0, cfg, st);

fun channelRejection (cli:APP_ID, st:STATUS) : CHANNEL_REJECTION =
  {client=cli, reason=st};</layout>
          </ml>
          <ml id="ID1412985474">fun newSession (sid:SESSION_ID, tok:AUTH_TOKEN, ch:SECURE_CHANNEL, me:APP_ID) : SESSION =
  mkSession(sid, tok, #channelId ch, #client ch, me, #config ch);

(* ActivateSession refere-se a esta sessao pendente? *)
fun matchSession (se:SESSION, cid:CHANNEL_ID, sid:SESSION_ID, tok:AUTH_TOKEN, cli:APP_ID) : bool =
  #channelId se = cid andalso #sessionId se = sid andalso
  #authToken se = tok andalso #client se = cli;

(* resposta no mesmo SecureChannel: remetente = servidor da sessao, destino = quem pediu *)
fun sessionResp (se:SESSION, cli:APP_ID, rid:INT, body:MSG_BODY, sl:SEAL) : NET_MSG =
  envelope(#server se, cli, rid, body, respondSeal(#server se, sl));

fun createSessionOk (se, cli, rid, sl, eps:POLICY_SUPPORT_LIST) : NET_MSG =
  sessionResp(se, cli, rid,
    CreateSessionResp {channelId = #channelId se, sessionId = #sessionId se,
                       authToken = #authToken se, status=OK, endpoints=eps}, sl);

fun activateOk (se:SESSION, cli:APP_ID, rid:INT, sl:SEAL) : NET_MSG =
  sessionResp(se, cli, rid,
              ActivateResp {channelId = #channelId se, sessionId = #sessionId se,
                            authToken = #authToken se, status=OK}, sl);

fun serviceOk (se:SESSION, cli:APP_ID, rid:INT, sl:SEAL) : NET_MSG =
  sessionResp(se, cli, rid, OtherServiceResp {authToken = #authToken se, status=OK}, sl);

fun closeSessionOk (se:SESSION, cli:APP_ID, rid:INT, sl:SEAL) : NET_MSG =
  sessionResp(se, cli, rid, CloseSessionResp {status=OK}, sl);

(* respostas de erro (ServiceFault) sem sessao/canal valido -&gt; sem seguranca *)
fun createSessionFault (cli, rid, st) : OUTBOUND_MSG =
  outbound(cli, rid,
    CreateSessionResp {channelId=0, sessionId=0, authToken=0, status=st, endpoints=[]}, NoneCfg);

fun serviceFault (cli:APP_ID, rid:INT, tok:AUTH_TOKEN, st:STATUS) : OUTBOUND_MSG =
  outbound(cli, rid, OtherServiceResp {authToken=tok, status=st}, NoneCfg);
            <layout>(* ===== CreateSession / ActivateSession / CloseSession / Service (lado servidor) -- Parte 4 5.7 ===== *)
fun newSession (sid:SESSION_ID, tok:AUTH_TOKEN, ch:SECURE_CHANNEL, me:APP_ID) : SESSION =
  mkSession(sid, tok, #channelId ch, #client ch, me, #config ch);

(* ActivateSession refere-se a esta sessao pendente? *)
fun matchSession (se:SESSION, cid:CHANNEL_ID, sid:SESSION_ID, tok:AUTH_TOKEN, cli:APP_ID) : bool =
  #channelId se = cid andalso #sessionId se = sid andalso
  #authToken se = tok andalso #client se = cli;

(* resposta no mesmo SecureChannel: remetente = servidor da sessao, destino = quem pediu *)
fun sessionResp (se:SESSION, cli:APP_ID, rid:INT, body:MSG_BODY, sl:SEAL) : NET_MSG =
  envelope(#server se, cli, rid, body, respondSeal(#server se, sl));

fun createSessionOk (se, cli, rid, sl, eps:POLICY_SUPPORT_LIST) : NET_MSG =
  sessionResp(se, cli, rid,
    CreateSessionResp {channelId = #channelId se, sessionId = #sessionId se,
                       authToken = #authToken se, status=OK, endpoints=eps}, sl);

fun activateOk (se:SESSION, cli:APP_ID, rid:INT, sl:SEAL) : NET_MSG =
  sessionResp(se, cli, rid,
              ActivateResp {channelId = #channelId se, sessionId = #sessionId se,
                            authToken = #authToken se, status=OK}, sl);

fun serviceOk (se:SESSION, cli:APP_ID, rid:INT, sl:SEAL) : NET_MSG =
  sessionResp(se, cli, rid, OtherServiceResp {authToken = #authToken se, status=OK}, sl);

fun closeSessionOk (se:SESSION, cli:APP_ID, rid:INT, sl:SEAL) : NET_MSG =
  sessionResp(se, cli, rid, CloseSessionResp {status=OK}, sl);

(* respostas de erro (ServiceFault) sem sessao/canal valido -&gt; sem seguranca *)
fun createSessionFault (cli, rid, st) : OUTBOUND_MSG =
  outbound(cli, rid,
    CreateSessionResp {channelId=0, sessionId=0, authToken=0, status=st, endpoints=[]}, NoneCfg);

fun serviceFault (cli:APP_ID, rid:INT, tok:AUTH_TOKEN, st:STATUS) : OUTBOUND_MSG =
  outbound(cli, rid, OtherServiceResp {authToken=tok, status=st}, NoneCfg);</layout>
          </ml>
          <ml id="ID95000065">(* ===== Servicos do AddressSpace (lado servidor) -- Parte 4 5.9 / 5.11 / 5.12 ===== *)
fun serviceCall (se:SESSION, cli:APP_ID, rid:INT, sl:SEAL, r:AS_REQUEST) : SESSION_SERVICE_CALL =
  {session = se, client = cli, reqId = rid, seal = sl, request = r};

(* resposta Good no mesmo SecureChannel da sessao (ResponseHeader.serviceResult = Good) *)
fun addressSpaceResp (se:SESSION, cli:APP_ID, rid:INT, sl:SEAL, res:AS_RESULT) : NET_MSG =
  sessionResp(se, cli, rid,
              AddressSpaceResp {authToken = #authToken se, serviceResult = OK, result = res}, sl);

(* ServiceFault sem sessao utilizavel -- Parte 4 7.36 (Bad_SessionClosed, Bad_SessionNotActivated) *)
fun addressSpaceFault (cli:APP_ID, rid:INT, tok:AUTH_TOKEN, st:STATUS) : OUTBOUND_MSG =
  outbound(cli, rid, AddressSpaceResp {authToken = tok, serviceResult = st, result = NoResult ()}, NoneCfg);
            <layout>(* ===== Servicos do AddressSpace (lado servidor) -- Parte 4 5.9 / 5.11 / 5.12 ===== *)
fun serviceCall (se:SESSION, cli:APP_ID, rid:INT, sl:SEAL, r:AS_REQUEST) : SESSION_SERVICE_CALL =
  {session = se, client = cli, reqId = rid, seal = sl, request = r};

(* resposta Good no mesmo SecureChannel da sessao (ResponseHeader.serviceResult = Good) *)
fun addressSpaceResp (se:SESSION, cli:APP_ID, rid:INT, sl:SEAL, res:AS_RESULT) : NET_MSG =
  sessionResp(se, cli, rid,
              AddressSpaceResp {authToken = #authToken se, serviceResult = OK, result = res}, sl);

(* ServiceFault sem sessao utilizavel -- Parte 4 7.36 (Bad_SessionClosed, Bad_SessionNotActivated) *)
fun addressSpaceFault (cli:APP_ID, rid:INT, tok:AUTH_TOKEN, st:STATUS) : OUTBOUND_MSG =
  outbound(cli, rid, AddressSpaceResp {authToken = tok, serviceResult = st, result = NoResult ()}, NoneCfg);</layout>
          </ml>
