  rolePermissions: ROLE_PERMISSION_LIST *
  references: REFERENCE_LIST * nodeBody: NODE_BODY;</layout>
            </color>
            <color id="ID95000028">
              <id>AS_NODE_LIST</id>
              <list>
                <id>AS_NODE</id>
