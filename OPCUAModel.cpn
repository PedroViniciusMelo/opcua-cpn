          <ml id="ID1439952479">fun findServersReq (gds:APP_ID, rid:INT, me:APP_ID) : OUTBOUND_MSG =
  outbound(gds, rid, FindServersReq {requesterUri=me}, NoneCfg);

fun getEndpointsReq (srv:APP_ID, rid:INT, me:APP_ID) : OUTBOUND_MSG =
  outbound(srv, rid, GetEndpointsReq {requesterUri=me}, NoneCfg);

fun isReplyFrom (gm:GATED_MSG, src:APP_ID, rid:INT) : bool =
  #src gm = src andalso #reqId gm = rid;

fun isFindServersResp (b:MSG_BODY) : bool =
  case b of FindServersResp _ =&gt; true | _ =&gt; false;

fun isGetEndpointsResp (b:MSG_BODY) : bool =
  case b of GetEndpointsResp _ =&gt; true | _ =&gt; false;

fun foundServers (b:MSG_BODY) : APP_ID ms =
  case b of FindServersResp r =&gt; appIdListToMS (#servers r) | _ =&gt; empty;

fun policySupportToConfigs ([]: POLICY_SUPPORT_LIST) : SECURITY_CONFIG_LIST = []
  | policySupportToConfigs ({policy=pol, allowedModes=modes}::xs) =
      let
        fun addModes [] = policySupportToConfigs xs
          | addModes (m::rest) = (pol, m) :: addModes rest
      in
        addModes modes
      end;

fun endpointConfigs (srv:APP_ID, b:MSG_BODY) : SERVER_CONFIGS =
  case b of
    GetEndpointsResp r =&gt; {server=srv, configs=policySupportToConfigs (#endpoints r)}
  | _ =&gt; {server=srv, configs=[]};

fun subsetConfigs ([], _) = true
  | subsetConfigs (x::xs, ys) = List.exists (fn y =&gt; y = x) ys andalso subsetConfigs(xs, ys);
fun sameConfigs (a, b) = subsetConfigs(a,b) andalso subsetConfigs(b,a);

fun respEndpoints (CreateSessionResp {endpoints,...}) = endpoints
  | respEndpoints _ = [];

(* discovered = lista obtida no GetEndpoints (Preferred Configs);
   eps = lista autoritativa vinda assinada no CreateSessionResp -- Parte 4 5.4.2 *)
fun endpointsOK (discovered:SECURITY_CONFIG_LIST, eps:POLICY_SUPPORT_LIST) : bool =
  sameConfigs(discovered, policySupportToConfigs eps);
            <layout>(* ===== FindServers / GetEndpoints (lado cliente) -- Parte 4 5.5.2 / 5.5.4 ===== *)
fun findServersReq (gds:APP_ID, rid:INT, me:APP_ID) : OUTBOUND_MSG =
  outbound(gds, rid, FindServersReq {requesterUri=me}, NoneCfg);

fun getEndpointsReq (srv:APP_ID, rid:INT, me:APP_ID) : OUTBOUND_MSG =
  outbound(srv, rid, GetEndpointsReq {requesterUri=me}, NoneCfg);

fun isReplyFrom (gm:GATED_MSG, src:APP_ID, rid:INT) : bool =
  #src gm = src andalso #reqId gm = rid;

fun isFindServersResp (b:MSG_BODY) : bool =
  case b of FindServersResp _ =&gt; true | _ =&gt; false;

fun isGetEndpointsResp (b:MSG_BODY) : bool =
  case b of GetEndpointsResp _ =&gt; true | _ =&gt; false;

fun foundServers (b:MSG_BODY) : APP_ID ms =
  case b of FindServersResp r =&gt; appIdListToMS (#servers r) | _ =&gt; empty;

fun policySupportToConfigs ([]: POLICY_SUPPORT_LIST) : SECURITY_CONFIG_LIST = []
  | policySupportToConfigs ({policy=pol, allowedModes=modes}::xs) =
      let
        fun addModes [] = policySupportToConfigs xs
          | addModes (m::rest) = (pol, m) :: addModes rest
      in
        addModes modes
      end;

fun endpointConfigs (srv:APP_ID, b:MSG_BODY) : SERVER_CONFIGS =
  case b of
    GetEndpointsResp r =&gt; {server=srv, configs=policySupportToConfigs (#endpoints r)}
  | _ =&gt; {server=srv, configs=[]};

fun subsetConfigs ([], _) = true
  | subsetConfigs (x::xs, ys) = List.exists (fn y =&gt; y = x) ys andalso subsetConfigs(xs, ys);
fun sameConfigs (a, b) = subsetConfigs(a,b) andalso subsetConfigs(b,a);

fun respEndpoints (CreateSessionResp {endpoints,...}) = endpoints
  | respEndpoints _ = [];

(* discovered = lista obtida no GetEndpoints (Preferred Configs);
   eps = lista autoritativa vinda assinada no CreateSessionResp -- Parte 4 5.4.2 *)
fun endpointsOK (discovered:SECURITY_CONFIG_LIST, eps:POLICY_SUPPORT_LIST) : bool =
  sameConfigs(discovered, policySupportToConfigs eps);</layout>
          </ml>
          <ml id="ID1439904295">fun isTrustedServer (srv:APP_ID, trustList:TRUST_ENTRY_LIST) : bool =
  List.exists (fn (a,d) =&gt; a = srv andalso d = TRUSTED) trustList;

(* Adiciona um servidor a lista do Discovery Server sem duplicatas *)
fun registerServerToList (srv:APP_ID, [] : APP_ID_LIST) : APP_ID_LIST = [srv]
  | registerServerToList (srv, x::xs) =
      if srv = x then x::xs else x :: registerServerToList(srv, xs);

fun registerServerReq (gds:APP_ID, rid:INT, me:APP_ID) : OUTBOUND_MSG =
  outbound(gds, rid, RegisterServerReq {serverUri=me}, NoneCfg);

fun registerServerResp (dst:APP_ID, rid:INT, st:STATUS) : OUTBOUND_MSG =
  outbound(dst, rid, RegisterServerResp {status=st}, NoneCfg);

fun findServersResp (dst:APP_ID, rid:INT, srvs:APP_ID_LIST) : OUTBOUND_MSG =
  outbound(dst, rid, FindServersResp {servers=srvs}, NoneCfg);

fun getEndpointsResp (dst:APP_ID, rid:INT, eps:POLICY_SUPPORT_LIST) : OUTBOUND_MSG =
  outbound(dst, rid, GetEndpointsResp {endpoints=eps}, NoneCfg);

fun isFindServersReq (b:MSG_BODY) : bool =
  case b of FindServersReq _ =&gt; true | _ =&gt; false;
            <layout>(* ===== RegisterServer / FindServers / GetEndpoints (Server e Discovery Server) -- Parte 4 5.5, Parte 12 ===== *)
fun isTrustedServer (srv:APP_ID, trustList:TRUST_ENTRY_LIST) : bool =
  List.exists (fn (a,d) =&gt; a = srv andalso d = TRUSTED) trustList;

(* Adiciona um servidor a lista do Discovery Server sem duplicatas *)
fun registerServerToList (srv:APP_ID, [] : APP_ID_LIST) : APP_ID_LIST = [srv]
  | registerServerToList (srv, x::xs) =
      if srv = x then x::xs else x :: registerServerToList(srv, xs);

fun registerServerReq (gds:APP_ID, rid:INT, me:APP_ID) : OUTBOUND_MSG =
  outbound(gds, rid, RegisterServerReq {serverUri=me}, NoneCfg);

fun registerServerResp (dst:APP_ID, rid:INT, st:STATUS) : OUTBOUND_MSG =
  outbound(dst, rid, RegisterServerResp {status=st}, NoneCfg);

fun findServersResp (dst:APP_ID, rid:INT, srvs:APP_ID_LIST) : OUTBOUND_MSG =
  outbound(dst, rid, FindServersResp {servers=srvs}, NoneCfg);

fun getEndpointsResp (dst:APP_ID, rid:INT, eps:POLICY_SUPPORT_LIST) : OUTBOUND_MSG =
  outbound(dst, rid, GetEndpointsResp {endpoints=eps}, NoneCfg);

fun isFindServersReq (b:MSG_BODY) : bool =
  case b of FindServersReq _ =&gt; true | _ =&gt; false;</layout>
          </ml>
        </block>
      </block>
