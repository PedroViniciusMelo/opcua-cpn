        <block id="ID1412925488">
          <id>Builders</id>
          <ml id="ID20090001">(* ===== OpenSecureChannel / CloseSecureChannel (lado cliente) -- Parte 4 5.6 ===== *)
fun isRetryable (st:STATUS) : bool =
  (st = BAD_SECURITY_MODE_REJECTED) orelse (st = BAD_SECURITY_POLICY_REJECTED);

(* condicao de desistencia do OpenSecureChannel *)
fun openFailed (st:STATUS, decision:TRUST_DECISION, rest:SECURITY_CONFIG_LIST) : bool =
  (st = OK andalso decision = REJECTED) orelse
  st = BAD_CERTIFICATE_UNTRUSTED orelse
  (isRetryable st andalso rest = []) orelse
  st = BAD_TCP_SERVER_TOO_BUSY;

fun pendingChannel (srv:APP_ID, rid:INT, rest:SECURITY_CONFIG_LIST) : PENDING_CHANNEL =
  {server=srv, reqId=rid, remaining=rest};

fun toChannel (b:MSG_BODY, me:APP_ID, srv:APP_ID) : SECURE_CHANNEL =
  case b of
    OpenChannelResp {channelId,config,...} =&gt; mkSecureChannel(channelId,me,srv,config)
  | _ =&gt; raise Fail &quot;toChannel: body inesperado&quot;;

(* CloseSecureChannel nao tem resposta -- Parte 6 7.1.4 *)
fun closeChannelReq (rid:INT, ch:SECURE_CHANNEL) : OUTBOUND_MSG =
  outbound(#server ch, rid, CloseChannelReq {channelId = #channelId ch}, #config ch);

fun failureReason (st:STATUS) : FAILURE_REASON =
  if st = OK then UNTRUSTED_BY_ME
  else if st = BAD_TCP_SERVER_TOO_BUSY then SERVER_TOO_BUSY
  else if st = BAD_CERTIFICATE_UNTRUSTED then REJECTED_BY_SERVER
  else POLICY_EXHAUSTED;
(* st = OK so chega aqui quando o proprio cliente rejeita o certificado do servidor *)

fun channelFailure (srv:APP_ID, st:STATUS) : CHANNEL_FAILURE =
  {server=srv, reason=failureReason st};
            <layout>(* ===== OpenSecureChannel / CloseSecureChannel (lado cliente) -- Parte 4 5.6 ===== *)
fun isRetryable (st:STATUS) : bool =
  (st = BAD_SECURITY_MODE_REJECTED) orelse (st = BAD_SECURITY_POLICY_REJECTED);

(* condicao de desistencia do OpenSecureChannel *)
fun openFailed (st:STATUS, decision:TRUST_DECISION, rest:SECURITY_CONFIG_LIST) : bool =
  (st = OK andalso decision = REJECTED) orelse
  st = BAD_CERTIFICATE_UNTRUSTED orelse
  (isRetryable st andalso rest = []) orelse
  st = BAD_TCP_SERVER_TOO_BUSY;

fun pendingChannel (srv:APP_ID, rid:INT, rest:SECURITY_CONFIG_LIST) : PENDING_CHANNEL =
  {server=srv, reqId=rid, remaining=rest};

fun toChannel (b:MSG_BODY, me:APP_ID, srv:APP_ID) : SECURE_CHANNEL =
  case b of
    OpenChannelResp {channelId,config,...} =&gt; mkSecureChannel(channelId,me,srv,config)
  | _ =&gt; raise Fail &quot;toChannel: body inesperado&quot;;

(* CloseSecureChannel nao tem resposta -- Parte 6 7.1.4 *)
fun closeChannelReq (rid:INT, ch:SECURE_CHANNEL) : OUTBOUND_MSG =
  outbound(#server ch, rid, CloseChannelReq {channelId = #channelId ch}, #config ch);

fun failureReason (st:STATUS) : FAILURE_REASON =
  if st = OK then UNTRUSTED_BY_ME
  else if st = BAD_TCP_SERVER_TOO_BUSY then SERVER_TOO_BUSY
  else if st = BAD_CERTIFICATE_UNTRUSTED then REJECTED_BY_SERVER
  else POLICY_EXHAUSTED;
(* st = OK so chega aqui quando o proprio cliente rejeita o certificado do servidor *)

fun channelFailure (srv:APP_ID, st:STATUS) : CHANNEL_FAILURE =
  {server=srv, reason=failureReason st};</layout>
          </ml>
          <ml id="ID20090002">(* ===== CreateSession / ActivateSession / CloseSession / Service (lado cliente) -- Parte 4 5.7 ===== *)
fun pendingSession (rid:INT, ch:SECURE_CHANNEL) : PENDING_SESSION =
  {channelId = #channelId ch, server = #server ch, reqId=rid, config = #config ch};

fun createSessionReq (rid:INT, ch:SECURE_CHANNEL) : OUTBOUND_MSG =
  outbound(#server ch, rid, CreateSessionReq {channelId = #channelId ch}, #config ch);

fun toSession (b:MSG_BODY, me:APP_ID, srv:APP_ID, sec:SECURITY_CONFIG) : SESSION =
  case b of
    CreateSessionResp {channelId,sessionId,authToken,...} =&gt; mkSession(sessionId,authToken,channelId,me,srv,sec)
  | _ =&gt; raise Fail &quot;toSession: body inesperado&quot;;

fun pendingActivation (rid:INT, se:SESSION) : PENDING_ACTIVATION =
  {session=se, reqId=rid};

fun activateReq (rid:INT, se:SESSION) : OUTBOUND_MSG =
  outbound(#server se, rid,
           ActivateReq {channelId = #channelId se, sessionId = #sessionId se,
                        authToken = #authToken se}, #sec se);

(* qualquer outro servico chamado dentro da sessao (Read/Write/Call...) *)
fun serviceReq (rid:INT, se:SESSION) : OUTBOUND_MSG =
  outbound(#server se, rid, OtherServiceReq {authToken = #authToken se}, #sec se);

fun closeSessionReq (rid:INT, se:SESSION) : OUTBOUND_MSG =
  outbound(#server se, rid, CloseSessionReq {authToken = #authToken se}, #sec se);
            <layout>(* ===== CreateSession / ActivateSession / CloseSession / Service (lado cliente) -- Parte 4 5.7 ===== *)
fun pendingSession (rid:INT, ch:SECURE_CHANNEL) : PENDING_SESSION =
  {channelId = #channelId ch, server = #server ch, reqId=rid, config = #config ch};

fun createSessionReq (rid:INT, ch:SECURE_CHANNEL) : OUTBOUND_MSG =
  outbound(#server ch, rid, CreateSessionReq {channelId = #channelId ch}, #config ch);

fun toSession (b:MSG_BODY, me:APP_ID, srv:APP_ID, sec:SECURITY_CONFIG) : SESSION =
  case b of
    CreateSessionResp {channelId,sessionId,authToken,...} =&gt; mkSession(sessionId,authToken,channelId,me,srv,sec)
  | _ =&gt; raise Fail &quot;toSession: body inesperado&quot;;

fun pendingActivation (rid:INT, se:SESSION) : PENDING_ACTIVATION =
  {session=se, reqId=rid};

fun activateReq (rid:INT, se:SESSION) : OUTBOUND_MSG =
  outbound(#server se, rid,
           ActivateReq {channelId = #channelId se, sessionId = #sessionId se,
                        authToken = #authToken se}, #sec se);

(* qualquer outro servico chamado dentro da sessao (Read/Write/Call...) *)
fun serviceReq (rid:INT, se:SESSION) : OUTBOUND_MSG =
  outbound(#server se, rid, OtherServiceReq {authToken = #authToken se}, #sec se);

fun closeSessionReq (rid:INT, se:SESSION) : OUTBOUND_MSG =
  outbound(#server se, rid, CloseSessionReq {authToken = #authToken se}, #sec se);</layout>
          </ml>
          <ml id="ID95000057">(* ===== Servicos do AddressSpace (lado cliente) -- Parte 4 5.9 / 5.11 / 5.12 ===== *)
(* a requisicao viaja na sessao ativa: authenticationToken + seguranca do canal -- Parte 4 7.32 *)
fun addressSpaceReq (rid:INT, se:SESSION, r:AS_REQUEST) : OUTBOUND_MSG =
  outbound(#server se, rid, AddressSpaceReq {authToken = #authToken se, request = r}, #sec se);

fun pendingAsRequest (rid:INT, se:SESSION, r:AS_REQUEST) : PENDING_AS_REQUEST =
  {server = #server se, reqId = rid, request = r};

fun asOutcome (srv:APP_ID, r:AS_REQUEST, st:STATUS, res:AS_RESULT) : AS_OUTCOME =
  {server = srv, request = r, serviceResult = st, result = res};
            <layout>(* ===== Servicos do AddressSpace (lado cliente) -- Parte 4 5.9 / 5.11 / 5.12 ===== *)
(* a requisicao viaja na sessao ativa: authenticationToken + seguranca do canal -- Parte 4 7.32 *)
fun addressSpaceReq (rid:INT, se:SESSION, r:AS_REQUEST) : OUTBOUND_MSG =
  outbound(#server se, rid, AddressSpaceReq {authToken = #authToken se, request = r}, #sec se);

fun pendingAsRequest (rid:INT, se:SESSION, r:AS_REQUEST) : PENDING_AS_REQUEST =
  {server = #server se, reqId = rid, request = r};

fun asOutcome (srv:APP_ID, r:AS_REQUEST, st:STATUS, res:AS_RESULT) : AS_OUTCOME =
  {server = srv, request = r, serviceResult = st, result = res};</layout>
          </ml>
          <ml id="ID20440010">fun appIdListToMS ([]:APP_ID list) : APP_ID ms = empty
  | appIdListToMS (x::xs) = 1`x ++ appIdListToMS xs;

fun configsListToMS ([]:SERVER_CONFIGS list) : SERVER_CONFIGS ms = empty
  | configsListToMS (x::xs) = 1`x ++ configsListToMS xs;
            <layout>fun appIdListToMS ([]:APP_ID list) : APP_ID ms = empty
  | appIdListToMS (x::xs) = 1`x ++ appIdListToMS xs;

fun configsListToMS ([]:SERVER_CONFIGS list) : SERVER_CONFIGS ms = empty
  | configsListToMS (x::xs) = 1`x ++ configsListToMS xs;</layout>
