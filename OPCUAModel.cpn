                <recordfield>
                  <id>methodId</id>
                  <id>NODE_ID</id>
                </recordfield>
                <recordfield>
                  <id>inputArguments</id>
                  <id>VARIANT_LIST</id>
                </recordfield>
              </record>
              <layout>colset CALL_METHOD_REQUEST = record
  objectId: NODE_ID * methodId: NODE_ID * inputArguments: VARIANT_LIST;
(* CallMethodRequest -- Parte 4 5.12.2.2 Tabela 59 *)</layout>
            </color>
            <color id="ID95000035">
              <id>BROWSE_DIRECTION</id>
              <enum>
                <id>BD_FORWARD</id>
                <id>BD_INVERSE</id>
                <id>BD_BOTH</id>
              </enum>
              <layout>colset BROWSE_DIRECTION = with BD_FORWARD | BD_INVERSE | BD_BOTH;
(* BrowseDirection -- Parte 4 7.5 Tabela 112 *)</layout>
            </color>
            <color id="ID95000036">
              <id>REFERENCE_FILTER</id>
              <union>
                <unionfield>
                  <id>AllReferences</id>
                  <type>
                    <id>UNIT</id>
                  </type>
                </unionfield>
                <unionfield>
                  <id>OnlyReferenceType</id>
                  <type>
                    <id>REFERENCE_TYPE</id>
                  </type>
                </unionfield>
              </union>
              <layout>colset REFERENCE_FILTER =
  union AllReferences     : UNIT +
        OnlyReferenceType : REFERENCE_TYPE;
(* referenceTypeId do BrowseDescription: nao especificado = todas -- Parte 4 5.9.2.2 *)</layout>
            </color>
            <color id="ID95000037">
              <id>BROWSE_DESCRIPTION</id>
              <record>
                <recordfield>
                  <id>nodeId</id>
                  <id>NODE_ID</id>
                </recordfield>
                <recordfield>
                  <id>browseDirection</id>
                  <id>BROWSE_DIRECTION</id>
                </recordfield>
                <recordfield>
                  <id>referenceTypeId</id>
                  <id>REFERENCE_FILTER</id>
                </recordfield>
              </record>
              <layout>colset BROWSE_DESCRIPTION = record
  nodeId: NODE_ID * browseDirection: BROWSE_DIRECTION * referenceTypeId: REFERENCE_FILTER;
(* BrowseDescription -- Parte 4 5.9.2.2 Tabela 34 (nodeClassMask/resultMask omitidos) *)</layout>
            </color>
            <color id="ID95000038">
              <id>AS_REQUEST</id>
              <union>
                <unionfield>
                  <id>ReadRequest</id>
                  <type>
                    <id>READ_VALUE_ID</id>
                  </type>
                </unionfield>
                <unionfield>
                  <id>WriteRequest</id>
                  <type>
                    <id>WRITE_VALUE</id>
                  </type>
                </unionfield>
                <unionfield>
                  <id>CallRequest</id>
                  <type>
                    <id>CALL_METHOD_REQUEST</id>
                  </type>
                </unionfield>
                <unionfield>
                  <id>BrowseRequest</id>
                  <type>
                    <id>BROWSE_DESCRIPTION</id>
                  </type>
                </unionfield>
              </union>
              <layout>colset AS_REQUEST =
  union ReadRequest   : READ_VALUE_ID +
        WriteRequest  : WRITE_VALUE +
        CallRequest   : CALL_METHOD_REQUEST +
        BrowseRequest : BROWSE_DESCRIPTION;
(* uma operacao por requisicao (listas de tamanho 1) -- Read 5.11.2, Write 5.11.4,
   Call 5.12.2, Browse 5.9.2 da Parte 4. Novo servico = novo ramo aqui *)</layout>
            </color>
            <color id="ID95000039">
              <id>DATA_VALUE</id>
              <record>
                <recordfield>
                  <id>value</id>
                  <id>VARIANT</id>
                </recordfield>
                <recordfield>
                  <id>statusCode</id>
                  <id>STATUS</id>
                </recordfield>
              </record>
              <layout>colset DATA_VALUE = record value: VARIANT * statusCode: STATUS;
(* DataValue -- Parte 4 7.11 (timestamps omitidos: rede nao temporizada) *)</layout>
            </color>
            <color id="ID95000040">
              <id>CALL_METHOD_RESULT</id>
              <record>
                <recordfield>
                  <id>statusCode</id>
                  <id>STATUS</id>
                </recordfield>
                <recordfield>
                  <id>inputArgumentResults</id>
                  <id>STATUS_LIST</id>
                </recordfield>
                <recordfield>
                  <id>outputArguments</id>
                  <id>VARIANT_LIST</id>
                </recordfield>
              </record>
              <layout>colset CALL_METHOD_RESULT = record
  statusCode: STATUS * inputArgumentResults: STATUS_LIST * outputArguments: VARIANT_LIST;
(* CallMethodResult -- Parte 4 5.12.2.2 Tabela 59 *)</layout>
            </color>
            <color id="ID95000041">
              <id>REFERENCE_DESCRIPTION</id>
              <record>
                <recordfield>
                  <id>referenceTypeId</id>
                  <id>REFERENCE_TYPE</id>
                </recordfield>
                <recordfield>
                  <id>isForward</id>
                  <id>BOOL</id>
                </recordfield>
                <recordfield>
                  <id>nodeId</id>
                  <id>NODE_ID</id>
                </recordfield>
                <recordfield>
                  <id>browseName</id>
                  <id>STRING</id>
                </recordfield>
                <recordfield>
                  <id>nodeClass</id>
                  <id>NODE_CLASS</id>
                </recordfield>
              </record>
              <layout>colset REFERENCE_DESCRIPTION = record
  referenceTypeId: REFERENCE_TYPE * isForward: BOOL * nodeId: NODE_ID *
  browseName: STRING * nodeClass: NODE_CLASS;
(* ReferenceDescription -- Parte 4 7.29 Tabela 168 *)</layout>
            </color>
            <color id="ID95000042">
              <id>REFERENCE_DESCRIPTION_LIST</id>
              <list>
                <id>REFERENCE_DESCRIPTION</id>
              </list>
              <layout>colset REFERENCE_DESCRIPTION_LIST = list REFERENCE_DESCRIPTION;</layout>
            </color>
            <color id="ID95000043">
              <id>BROWSE_RESULT</id>
              <record>
                <recordfield>
                  <id>statusCode</id>
                  <id>STATUS</id>
                </recordfield>
                <recordfield>
                  <id>references</id>
                  <id>REFERENCE_DESCRIPTION_LIST</id>
                </recordfield>
              </record>
              <layout>colset BROWSE_RESULT = record statusCode: STATUS * references: REFERENCE_DESCRIPTION_LIST;
(* BrowseResult -- Parte 4 7.6 (sem continuationPoint) *)</layout>
            </color>
            <color id="ID95000044">
              <id>AS_RESULT</id>
              <union>
                <unionfield>
                  <id>NoResult</id>
                  <type>
                    <id>UNIT</id>
                  </type>
                </unionfield>
                <unionfield>
                  <id>ReadResult</id>
                  <type>
                    <id>DATA_VALUE</id>
                  </type>
                </unionfield>
                <unionfield>
                  <id>WriteResult</id>
                  <type>
                    <id>STATUS</id>
                  </type>
                </unionfield>
                <unionfield>
                  <id>CallResult</id>
                  <type>
                    <id>CALL_METHOD_RESULT</id>
                  </type>
                </unionfield>
                <unionfield>
                  <id>BrowseResult</id>
                  <type>
                    <id>BROWSE_RESULT</id>
                  </type>
                </unionfield>
              </union>
              <layout>colset AS_RESULT =
  union NoResult     : UNIT +
        ReadResult   : DATA_VALUE +
        WriteResult  : STATUS +
        CallResult   : CALL_METHOD_RESULT +
        BrowseResult : BROWSE_RESULT;
(* resultado por operacao; NoResult = ServiceFault (so ResponseHeader) -- Parte 4 7.36 *)</layout>
            </color>
            <ml id="ID95000045">fun badValue (st:STATUS) : DATA_VALUE = {value = VNull (), statusCode = st};

fun readOperation (nodes:AS_NODE_LIST, rv:READ_VALUE_ID, sec:SECURITY_CONFIG, roles:ROLE_LIST) : DATA_VALUE =
  case findNode (#nodeId rv, nodes) of
      NONE =&gt; badValue BAD_NODE_ID_UNKNOWN
    | SOME n =&gt;
        if not (attributeValid (nodeClassOf n, #attributeId rv))
        then badValue BAD_ATTRIBUTE_ID_INVALID
        else if not (restrictionsMet (#accessRestrictions n, sec, false))
        then badValue BAD_SECURITY_MODE_INSUFFICIENT
        else (case (#attributeId rv, #nodeBody n) of
                  (AT_VALUE, VariableNode v) =&gt;
                    if not (mayRead (n, roles)) then badValue BAD_USER_ACCESS_DENIED
                    else if not (#currentRead (#accessLevel v)) then badValue BAD_NOT_READABLE
                    else if not (#currentRead (#userAccessLevel v)) then badValue BAD_USER_ACCESS_DENIED
                    else {value = #value v, statusCode = OK}
                | _ =&gt; if not (mayBrowse (n, roles)) then badValue BAD_USER_ACCESS_DENIED
                       else {value = readAttribute (n, #attributeId rv), statusCode = OK});

fun writeOperation (nodes:AS_NODE_LIST, wv:WRITE_VALUE, sec:SECURITY_CONFIG, roles:ROLE_LIST) : STATUS =
  case findNode (#nodeId wv, nodes) of
      NONE =&gt; BAD_NODE_ID_UNKNOWN
    | SOME n =&gt;
        if not (attributeValid (nodeClassOf n, #attributeId wv)) then BAD_ATTRIBUTE_ID_INVALID
        else if not (restrictionsMet (#accessRestrictions n, sec, false)) then BAD_SECURITY_MODE_INSUFFICIENT
        else (case (#attributeId wv, #nodeBody n) of
                  (AT_VALUE, VariableNode v) =&gt;
                    if not (mayWrite (n, roles)) then BAD_USER_ACCESS_DENIED
                    else if not (#currentWrite (#accessLevel v)) then BAD_NOT_WRITABLE
                    else if not (#currentWrite (#userAccessLevel v)) then BAD_USER_ACCESS_DENIED
                    else if not (typeMatches (#value wv, #dataType v)) then BAD_TYPE_MISMATCH
                    else OK
                | _ =&gt; BAD_NOT_WRITABLE);

fun applyWrite (nodes:AS_NODE_LIST, wv:WRITE_VALUE, sec:SECURITY_CONFIG, roles:ROLE_LIST) : AS_NODE_LIST =
  if writeOperation (nodes, wv, sec, roles) = OK then setValue (nodes, #nodeId wv, #value wv) else nodes;

fun hasComponent (n:AS_NODE, target:NODE_ID) : bool =
  List.exists (fn (r:REFERENCE) =&gt; #referenceTypeId r = RT_HAS_COMPONENT andalso #targetId r = target)
              (#references n);

fun argumentResults ([]:VARIANT_LIST, _:DATA_TYPE_LIST) : STATUS_LIST = []
  | argumentResults (_, []) = []
  | argumentResults (a::args, t::types) =
      (if typeMatches (a, t) then OK else BAD_TYPE_MISMATCH) :: argumentResults (args, types);

fun callFault (st:STATUS) : CALL_METHOD_RESULT =
  {statusCode = st, inputArgumentResults = [], outputArguments = []};

fun methodOutputs (nodes:AS_NODE_LIST, eff:METHOD_EFFECT) : VARIANT_LIST =
  case eff of
      GetValueOf nid =&gt; (case findNode (nid, nodes) of
                             SOME n =&gt; [readAttribute (n, AT_VALUE)]
                           | NONE =&gt; [])
    | _ =&gt; [];

fun callOperation (nodes:AS_NODE_LIST, cm:CALL_METHOD_REQUEST, sec:SECURITY_CONFIG, roles:ROLE_LIST) : CALL_METHOD_RESULT =
  case findNode (#objectId cm, nodes) of
      NONE =&gt; callFault BAD_NODE_ID_UNKNOWN
    | SOME obj =&gt;
        if nodeClassOf obj &lt;&gt; NC_OBJECT then callFault BAD_NODE_ID_INVALID
        else if not (hasComponent (obj, #methodId cm)) then callFault BAD_METHOD_INVALID
        else (case findNode (#methodId cm, nodes) of
                  NONE =&gt; callFault BAD_METHOD_INVALID
                | SOME mn =&gt;
                    (case #nodeBody mn of
                         MethodNode m =&gt;
                           if not (restrictionsMet (#accessRestrictions obj, sec, false) andalso
                                   restrictionsMet (#accessRestrictions mn, sec, false))
                           then callFault BAD_SECURITY_MODE_INSUFFICIENT
                           else if not (mayCall (obj, roles) andalso mayCall (mn, roles))
                           then callFault BAD_USER_ACCESS_DENIED
                           else if not (#executable m) then callFault BAD_NOT_EXECUTABLE
                           else if not (#userExecutable m) then callFault BAD_USER_ACCESS_DENIED
                           else if length (#inputArguments cm) &lt; length (#inputArguments m)
                           then callFault BAD_ARGUMENTS_MISSING
                           else if length (#inputArguments cm) &gt; length (#inputArguments m)
                           then callFault BAD_TOO_MANY_ARGUMENTS
                           else
                             let val argRes = argumentResults (#inputArguments cm, #inputArguments m)
                             in
                               if List.exists (fn x =&gt; x &lt;&gt; OK) argRes
                               then {statusCode = BAD_INVALID_ARGUMENT,
                                     inputArgumentResults = argRes, outputArguments = []}
                               else {statusCode = OK, inputArgumentResults = [],
                                     outputArguments = methodOutputs (nodes, #effect m)}
                             end
                       | _ =&gt; callFault BAD_METHOD_INVALID));

fun applyCall (nodes:AS_NODE_LIST, cm:CALL_METHOD_REQUEST, sec:SECURITY_CONFIG, roles:ROLE_LIST) : AS_NODE_LIST =
  if #statusCode (callOperation (nodes, cm, sec, roles)) &lt;&gt; OK then nodes
  else (case (findNode (#methodId cm, nodes), #inputArguments cm) of
            (SOME mn, arg::_) =&gt;
              (case #nodeBody mn of
                   MethodNode m =&gt; (case #effect m of
                                        SetValueOf target =&gt; setValue (nodes, target, arg)
                                      | _ =&gt; nodes)
                 | _ =&gt; nodes)
          | _ =&gt; nodes);

fun refMatches (filter:REFERENCE_FILTER, rt:REFERENCE_TYPE) : bool =
  case filter of
      AllReferences _     =&gt; true
    | OnlyReferenceType t =&gt; t = rt;

fun rdConcat ([]:REFERENCE_DESCRIPTION_LIST, ys) = ys
  | rdConcat (x::xs, ys) = x :: rdConcat (xs, ys);

fun browsable (n:AS_NODE, sec:SECURITY_CONFIG, roles:ROLE_LIST) : bool =
  restrictionsMet (#accessRestrictions n, sec, true) andalso mayBrowse (n, roles);

fun describeRef (rt:REFERENCE_TYPE, fwd:bool, t:AS_NODE) : REFERENCE_DESCRIPTION =
  {referenceTypeId = rt, isForward = fwd, nodeId = #nodeId t,
   browseName = #browseName t, nodeClass = nodeClassOf t};

fun forwardRefs (nodes:AS_NODE_LIST, n:AS_NODE, bd:BROWSE_DESCRIPTION, sec:SECURITY_CONFIG, roles:ROLE_LIST)
    : REFERENCE_DESCRIPTION_LIST =
  List.mapPartial
    (fn (r:REFERENCE) =&gt;
       case findNode (#targetId r, nodes) of
           SOME t =&gt; if refMatches (#referenceTypeId bd, #referenceTypeId r) andalso browsable (t, sec, roles)
                     then SOME (describeRef (#referenceTypeId r, true, t)) else NONE
         | NONE =&gt; NONE)
    (#references n);

fun inverseRefs (nodes:AS_NODE_LIST, n:AS_NODE, bd:BROWSE_DESCRIPTION, sec:SECURITY_CONFIG, roles:ROLE_LIST)
    : REFERENCE_DESCRIPTION_LIST =
  List.concat
    (List.map
       (fn (src:AS_NODE) =&gt;
          List.mapPartial
            (fn (r:REFERENCE) =&gt;
               if #targetId r = #nodeId n andalso refMatches (#referenceTypeId bd, #referenceTypeId r)
                  andalso browsable (src, sec, roles)
               then SOME (describeRef (#referenceTypeId r, false, src)) else NONE)
            (#references src))
       nodes);

fun browseOperation (nodes:AS_NODE_LIST, bd:BROWSE_DESCRIPTION, sec:SECURITY_CONFIG, roles:ROLE_LIST) : BROWSE_RESULT =
  case findNode (#nodeId bd, nodes) of
      NONE =&gt; {statusCode = BAD_NODE_ID_UNKNOWN, references = []}
    | SOME n =&gt;
        if not (restrictionsMet (#accessRestrictions n, sec, true))
        then {statusCode = BAD_SECURITY_MODE_INSUFFICIENT, references = []}
        else if not (mayBrowse (n, roles))
        then {statusCode = BAD_USER_ACCESS_DENIED, references = []}
        else {statusCode = OK,
              references = (case #browseDirection bd of
                                BD_FORWARD =&gt; forwardRefs (nodes, n, bd, sec, roles)
                              | BD_INVERSE =&gt; inverseRefs (nodes, n, bd, sec, roles)
                              | BD_BOTH    =&gt; rdConcat (forwardRefs (nodes, n, bd, sec, roles),
                                                       inverseRefs (nodes, n, bd, sec, roles)))};
              <layout>fun badValue (st:STATUS) : DATA_VALUE = {value = VNull (), statusCode = st};

fun readOperation (nodes:AS_NODE_LIST, rv:READ_VALUE_ID, sec:SECURITY_CONFIG, roles:ROLE_LIST) : DATA_VALUE =
  case findNode (#nodeId rv, nodes) of
      NONE =&gt; badValue BAD_NODE_ID_UNKNOWN
    | SOME n =&gt;
        if not (attributeValid (nodeClassOf n, #attributeId rv))
        then badValue BAD_ATTRIBUTE_ID_INVALID
        else if not (restrictionsMet (#accessRestrictions n, sec, false))
        then badValue BAD_SECURITY_MODE_INSUFFICIENT
        else (case (#attributeId rv, #nodeBody n) of
                  (AT_VALUE, VariableNode v) =&gt;
                    if not (mayRead (n, roles)) then badValue BAD_USER_ACCESS_DENIED
                    else if not (#currentRead (#accessLevel v)) then badValue BAD_NOT_READABLE
                    else if not (#currentRead (#userAccessLevel v)) then badValue BAD_USER_ACCESS_DENIED
                    else {value = #value v, statusCode = OK}
                | _ =&gt; if not (mayBrowse (n, roles)) then badValue BAD_USER_ACCESS_DENIED
                       else {value = readAttribute (n, #attributeId rv), statusCode = OK});

fun writeOperation (nodes:AS_NODE_LIST, wv:WRITE_VALUE, sec:SECURITY_CONFIG, roles:ROLE_LIST) : STATUS =
  case findNode (#nodeId wv, nodes) of
      NONE =&gt; BAD_NODE_ID_UNKNOWN
    | SOME n =&gt;
        if not (attributeValid (nodeClassOf n, #attributeId wv)) then BAD_ATTRIBUTE_ID_INVALID
        else if not (restrictionsMet (#accessRestrictions n, sec, false)) then BAD_SECURITY_MODE_INSUFFICIENT
        else (case (#attributeId wv, #nodeBody n) of
                  (AT_VALUE, VariableNode v) =&gt;
                    if not (mayWrite (n, roles)) then BAD_USER_ACCESS_DENIED
                    else if not (#currentWrite (#accessLevel v)) then BAD_NOT_WRITABLE
                    else if not (#currentWrite (#userAccessLevel v)) then BAD_USER_ACCESS_DENIED
                    else if not (typeMatches (#value wv, #dataType v)) then BAD_TYPE_MISMATCH
                    else OK
                | _ =&gt; BAD_NOT_WRITABLE);

fun applyWrite (nodes:AS_NODE_LIST, wv:WRITE_VALUE, sec:SECURITY_CONFIG, roles:ROLE_LIST) : AS_NODE_LIST =
  if writeOperation (nodes, wv, sec, roles) = OK then setValue (nodes, #nodeId wv, #value wv) else nodes;

fun hasComponent (n:AS_NODE, target:NODE_ID) : bool =
  List.exists (fn (r:REFERENCE) =&gt; #referenceTypeId r = RT_HAS_COMPONENT andalso #targetId r = target)
              (#references n);

fun argumentResults ([]:VARIANT_LIST, _:DATA_TYPE_LIST) : STATUS_LIST = []
  | argumentResults (_, []) = []
  | argumentResults (a::args, t::types) =
      (if typeMatches (a, t) then OK else BAD_TYPE_MISMATCH) :: argumentResults (args, types);

fun callFault (st:STATUS) : CALL_METHOD_RESULT =
  {statusCode = st, inputArgumentResults = [], outputArguments = []};

fun methodOutputs (nodes:AS_NODE_LIST, eff:METHOD_EFFECT) : VARIANT_LIST =
  case eff of
      GetValueOf nid =&gt; (case findNode (nid, nodes) of
                             SOME n =&gt; [readAttribute (n, AT_VALUE)]
                           | NONE =&gt; [])
    | _ =&gt; [];

fun callOperation (nodes:AS_NODE_LIST, cm:CALL_METHOD_REQUEST, sec:SECURITY_CONFIG, roles:ROLE_LIST) : CALL_METHOD_RESULT =
  case findNode (#objectId cm, nodes) of
      NONE =&gt; callFault BAD_NODE_ID_UNKNOWN
    | SOME obj =&gt;
        if nodeClassOf obj &lt;&gt; NC_OBJECT then callFault BAD_NODE_ID_INVALID
        else if not (hasComponent (obj, #methodId cm)) then callFault BAD_METHOD_INVALID
        else (case findNode (#methodId cm, nodes) of
                  NONE =&gt; callFault BAD_METHOD_INVALID
                | SOME mn =&gt;
                    (case #nodeBody mn of
                         MethodNode m =&gt;
                           if not (restrictionsMet (#accessRestrictions obj, sec, false) andalso
                                   restrictionsMet (#accessRestrictions mn, sec, false))
                           then callFault BAD_SECURITY_MODE_INSUFFICIENT
                           else if not (mayCall (obj, roles) andalso mayCall (mn, roles))
                           then callFault BAD_USER_ACCESS_DENIED
                           else if not (#executable m) then callFault BAD_NOT_EXECUTABLE
                           else if not (#userExecutable m) then callFault BAD_USER_ACCESS_DENIED
                           else if length (#inputArguments cm) &lt; length (#inputArguments m)
                           then callFault BAD_ARGUMENTS_MISSING
                           else if length (#inputArguments cm) &gt; length (#inputArguments m)
                           then callFault BAD_TOO_MANY_ARGUMENTS
                           else
                             let val argRes = argumentResults (#inputArguments cm, #inputArguments m)
                             in
                               if List.exists (fn x =&gt; x &lt;&gt; OK) argRes
                               then {statusCode = BAD_INVALID_ARGUMENT,
                                     inputArgumentResults = argRes, outputArguments = []}
                               else {statusCode = OK, inputArgumentResults = [],
                                     outputArguments = methodOutputs (nodes, #effect m)}
                             end
                       | _ =&gt; callFault BAD_METHOD_INVALID));

fun applyCall (nodes:AS_NODE_LIST, cm:CALL_METHOD_REQUEST, sec:SECURITY_CONFIG, roles:ROLE_LIST) : AS_NODE_LIST =
  if #statusCode (callOperation (nodes, cm, sec, roles)) &lt;&gt; OK then nodes
  else (case (findNode (#methodId cm, nodes), #inputArguments cm) of
            (SOME mn, arg::_) =&gt;
              (case #nodeBody mn of
                   MethodNode m =&gt; (case #effect m of
                                        SetValueOf target =&gt; setValue (nodes, target, arg)
                                      | _ =&gt; nodes)
                 | _ =&gt; nodes)
          | _ =&gt; nodes);

fun refMatches (filter:REFERENCE_FILTER, rt:REFERENCE_TYPE) : bool =
  case filter of
      AllReferences _     =&gt; true
    | OnlyReferenceType t =&gt; t = rt;

fun rdConcat ([]:REFERENCE_DESCRIPTION_LIST, ys) = ys
  | rdConcat (x::xs, ys) = x :: rdConcat (xs, ys);

fun browsable (n:AS_NODE, sec:SECURITY_CONFIG, roles:ROLE_LIST) : bool =
  restrictionsMet (#accessRestrictions n, sec, true) andalso mayBrowse (n, roles);

fun describeRef (rt:REFERENCE_TYPE, fwd:bool, t:AS_NODE) : REFERENCE_DESCRIPTION =
  {referenceTypeId = rt, isForward = fwd, nodeId = #nodeId t,
   browseName = #browseName t, nodeClass = nodeClassOf t};

fun forwardRefs (nodes:AS_NODE_LIST, n:AS_NODE, bd:BROWSE_DESCRIPTION, sec:SECURITY_CONFIG, roles:ROLE_LIST)
    : REFERENCE_DESCRIPTION_LIST =
  List.mapPartial
    (fn (r:REFERENCE) =&gt;
       case findNode (#targetId r, nodes) of
           SOME t =&gt; if refMatches (#referenceTypeId bd, #referenceTypeId r) andalso browsable (t, sec, roles)
                     then SOME (describeRef (#referenceTypeId r, true, t)) else NONE
         | NONE =&gt; NONE)
    (#references n);

fun inverseRefs (nodes:AS_NODE_LIST, n:AS_NODE, bd:BROWSE_DESCRIPTION, sec:SECURITY_CONFIG, roles:ROLE_LIST)
    : REFERENCE_DESCRIPTION_LIST =
  List.concat
    (List.map
       (fn (src:AS_NODE) =&gt;
          List.mapPartial
            (fn (r:REFERENCE) =&gt;
               if #targetId r = #nodeId n andalso refMatches (#referenceTypeId bd, #referenceTypeId r)
                  andalso browsable (src, sec, roles)
               then SOME (describeRef (#referenceTypeId r, false, src)) else NONE)
            (#references src))
       nodes);

fun browseOperation (nodes:AS_NODE_LIST, bd:BROWSE_DESCRIPTION, sec:SECURITY_CONFIG, roles:ROLE_LIST) : BROWSE_RESULT =
  case findNode (#nodeId bd, nodes) of
      NONE =&gt; {statusCode = BAD_NODE_ID_UNKNOWN, references = []}
    | SOME n =&gt;
        if not (restrictionsMet (#accessRestrictions n, sec, true))
        then {statusCode = BAD_SECURITY_MODE_INSUFFICIENT, references = []}
        else if not (mayBrowse (n, roles))
        then {statusCode = BAD_USER_ACCESS_DENIED, references = []}
        else {statusCode = OK,
              references = (case #browseDirection bd of
                                BD_FORWARD =&gt; forwardRefs (nodes, n, bd, sec, roles)
                              | BD_INVERSE =&gt; inverseRefs (nodes, n, bd, sec, roles)
                              | BD_BOTH    =&gt; rdConcat (forwardRefs (nodes, n, bd, sec, roles),
                                                       inverseRefs (nodes, n, bd, sec, roles)))};</layout>
            </ml>
          </block>
        </block>
