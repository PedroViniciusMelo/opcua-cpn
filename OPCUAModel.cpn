            <layout>colset CLIENT_CONFIG = record
  myId: APP_ID * trustList: TRUST_ENTRY_LIST * preferredConfigs: SERVER_CONFIGS_LIST *
  serversToContact: APP_ID_LIST * plannedOperations: PLANNED_OP_LIST;
(* plannedOperations: servicos de AddressSpace a executar, em ordem *)</layout>
