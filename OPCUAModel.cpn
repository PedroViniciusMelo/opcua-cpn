        <block id="ID91000004">
          <id>Functions</id>
          <ml id="ID20080001">fun envelope (src:APP_ID, dst:APP_ID, reqId:INT, body:MSG_BODY, seal:SEAL) : NET_MSG =
  {src=src, dst=dst, reqId=reqId, body=body, seal=seal};

fun outbound (dst:APP_ID, rid:INT, body:MSG_BODY, sec:SECURITY_CONFIG) : OUTBOUND_MSG =
  {dst=dst, reqId=rid, body=body, sec=sec};
            <layout>fun envelope (src:APP_ID, dst:APP_ID, reqId:INT, body:MSG_BODY, seal:SEAL) : NET_MSG =
  {src=src, dst=dst, reqId=reqId, body=body, seal=seal};

fun outbound (dst:APP_ID, rid:INT, body:MSG_BODY, sec:SECURITY_CONFIG) : OUTBOUND_MSG =
  {dst=dst, reqId=rid, body=body, sec=sec};</layout>
          </ml>
          <ml id="ID20700010">val NoSeal : SEAL = {mode=SM_NONE, policy=POLICY_NONE, signer=&quot;&quot;};

fun applySeal (signer:APP_ID, (policy,mode):SECURITY_CONFIG) : SEAL =
  {mode=mode, policy=policy, signer=signer};

fun policyBroken (p:SECURITY_POLICY) : bool =
  (p = BASIC128RSA15) orelse (p = BASIC256);

fun bodyExposed (seal:SEAL) : bool =
  (#mode seal &lt;&gt; SIGN_AND_ENCRYPT) orelse policyBroken(#policy seal);

fun inboundAccepted (claimedSrc:APP_ID, seal:SEAL, (chPol,chMode):SECURITY_CONFIG) : bool =
  case chMode of
      SM_NONE =&gt; true
    | _ =&gt; policyBroken(chPol)
           orelse ((#mode seal &lt;&gt; SM_NONE) andalso (#signer seal = claimedSrc));

fun respondSeal (me:APP_ID, inSeal:SEAL) : SEAL =
  {mode = #mode inSeal, policy = #policy inSeal, signer = me};

fun hasAuthToken (OtherServiceReq _)   = true
  | hasAuthToken (CloseSessionReq _)   = true
  | hasAuthToken (ActivateReq _)       = true
  | hasAuthToken (CreateSessionResp _) = true
  | hasAuthToken (ActivateResp _)      = true
  | hasAuthToken (OtherServiceResp _)  = true
  | hasAuthToken (AddressSpaceReq _)   = true
  | hasAuthToken (AddressSpaceResp _)  = true
  | hasAuthToken _ = false;

fun authTokenOf (OtherServiceReq {authToken})       = authToken
  | authTokenOf (CloseSessionReq {authToken})       = authToken
  | authTokenOf (ActivateReq {authToken,...})       = authToken
  | authTokenOf (CreateSessionResp {authToken,...}) = authToken
  | authTokenOf (ActivateResp {authToken,...})      = authToken
  | authTokenOf (OtherServiceResp {authToken,...})  = authToken
  | authTokenOf (AddressSpaceReq {authToken,...})   = authToken
  | authTokenOf (AddressSpaceResp {authToken,...})  = authToken
  | authTokenOf _ = 0;
            <layout>val NoSeal : SEAL = {mode=SM_NONE, policy=POLICY_NONE, signer=&quot;&quot;};

fun applySeal (signer:APP_ID, (policy,mode):SECURITY_CONFIG) : SEAL =
  {mode=mode, policy=policy, signer=signer};

fun policyBroken (p:SECURITY_POLICY) : bool =
  (p = BASIC128RSA15) orelse (p = BASIC256);

fun bodyExposed (seal:SEAL) : bool =
  (#mode seal &lt;&gt; SIGN_AND_ENCRYPT) orelse policyBroken(#policy seal);

fun inboundAccepted (claimedSrc:APP_ID, seal:SEAL, (chPol,chMode):SECURITY_CONFIG) : bool =
  case chMode of
      SM_NONE =&gt; true
    | _ =&gt; policyBroken(chPol)
           orelse ((#mode seal &lt;&gt; SM_NONE) andalso (#signer seal = claimedSrc));

fun respondSeal (me:APP_ID, inSeal:SEAL) : SEAL =
  {mode = #mode inSeal, policy = #policy inSeal, signer = me};

fun hasAuthToken (OtherServiceReq _)   = true
  | hasAuthToken (CloseSessionReq _)   = true
  | hasAuthToken (ActivateReq _)       = true
  | hasAuthToken (CreateSessionResp _) = true
  | hasAuthToken (ActivateResp _)      = true
  | hasAuthToken (OtherServiceResp _)  = true
  | hasAuthToken (AddressSpaceReq _)   = true
  | hasAuthToken (AddressSpaceResp _)  = true
  | hasAuthToken _ = false;

fun authTokenOf (OtherServiceReq {authToken})       = authToken
  | authTokenOf (CloseSessionReq {authToken})       = authToken
  | authTokenOf (ActivateReq {authToken,...})       = authToken
  | authTokenOf (CreateSessionResp {authToken,...}) = authToken
  | authTokenOf (ActivateResp {authToken,...})      = authToken
  | authTokenOf (OtherServiceResp {authToken,...})  = authToken
  | authTokenOf (AddressSpaceReq {authToken,...})   = authToken
  | authTokenOf (AddressSpaceResp {authToken,...})  = authToken
  | authTokenOf _ = 0;</layout>
          </ml>
          <ml id="ID20700030">val NoneCfg : SECURITY_CONFIG = (POLICY_NONE, SM_NONE);
            <layout>val NoneCfg : SECURITY_CONFIG = (POLICY_NONE, SM_NONE);</layout>
          </ml>
          <ml id="ID91000100">fun gate (m:NET_MSG) : GATED_MSG =
  {src = #src m, reqId = #reqId m, body = #body m, seal = #seal m};

fun stamp (me:APP_ID, ob:OUTBOUND_MSG) : NET_MSG =
  envelope(me, #dst ob, #reqId ob, #body ob, applySeal(me, #sec ob));
            <layout>fun gate (m:NET_MSG) : GATED_MSG =
  {src = #src m, reqId = #reqId m, body = #body m, seal = #seal m};

fun stamp (me:APP_ID, ob:OUTBOUND_MSG) : NET_MSG =
  envelope(me, #dst ob, #reqId ob, #body ob, applySeal(me, #sec ob));</layout>
          </ml>
          <ml id="ID20080002">fun statusOf (OpenChannelResp {status,...})   = status
  | statusOf (CreateSessionResp {status,...}) = status
  | statusOf (ActivateResp {status,...})      = status
  | statusOf _ = raise Fail &quot;statusOf: body sem campo status&quot;;
            <layout>fun statusOf (OpenChannelResp {status,...})   = status
  | statusOf (CreateSessionResp {status,...}) = status
  | statusOf (ActivateResp {status,...})      = status
  | statusOf _ = raise Fail &quot;statusOf: body sem campo status&quot;;</layout>
          </ml>
          <ml id="ID95000066">fun toServerEngine (b:MSG_BODY) : bool =
  case b of
      OpenChannelReq _     =&gt; true
    | CreateSessionReq _   =&gt; true
    | ActivateReq _        =&gt; true
    | CloseChannelReq _    =&gt; true
    | CloseSessionReq _    =&gt; true
    | OtherServiceReq _    =&gt; true
    | AddressSpaceReq _    =&gt; true
    | GetEndpointsReq _    =&gt; true
    | RegisterServerResp _ =&gt; true
    | _                    =&gt; false;
            <layout>fun toServerEngine (b:MSG_BODY) : bool =
  case b of
      OpenChannelReq _     =&gt; true
    | CreateSessionReq _   =&gt; true
    | ActivateReq _        =&gt; true
    | CloseChannelReq _    =&gt; true
    | CloseSessionReq _    =&gt; true
    | OtherServiceReq _    =&gt; true
    | AddressSpaceReq _    =&gt; true
    | GetEndpointsReq _    =&gt; true
    | RegisterServerResp _ =&gt; true
    | _                    =&gt; false;</layout>
          </ml>
          <ml id="ID20090010">fun mkSecureChannel (chId:CHANNEL_ID, client:APP_ID, server:APP_ID, cfg:SECURITY_CONFIG) : SECURE_CHANNEL =
  {channelId=chId, client=client, server=server, config=cfg, tokenId=chId};
            <layout>fun mkSecureChannel (chId:CHANNEL_ID, client:APP_ID, server:APP_ID, cfg:SECURITY_CONFIG) : SECURE_CHANNEL =
  {channelId=chId, client=client, server=server, config=cfg, tokenId=chId};</layout>
          </ml>
          <ml id="ID20090011">fun mkSession (sesId:SESSION_ID, tok:AUTH_TOKEN, chId:CHANNEL_ID, client:APP_ID, server:APP_ID, sec:SECURITY_CONFIG) : SESSION =
  {sessionId=sesId, authToken=tok, channelId=chId, client=client, server=server, sec=sec};
            <layout>fun mkSession (sesId:SESSION_ID, tok:AUTH_TOKEN, chId:CHANNEL_ID, client:APP_ID, server:APP_ID, sec:SECURITY_CONFIG) : SESSION =
  {sessionId=sesId, authToken=tok, channelId=chId, client=client, server=server, sec=sec};</layout>
          </ml>
          <ml id="ID1412933065">fun openChannelReq (me:APP_ID, srv:APP_ID, rid:INT, cfg:SECURITY_CONFIG) : NET_MSG =
  envelope(me, srv, rid, OpenChannelReq {cert={owner=me}, config=cfg}, applySeal(me,cfg));
            <layout>fun openChannelReq (me:APP_ID, srv:APP_ID, rid:INT, cfg:SECURITY_CONFIG) : NET_MSG =
  envelope(me, srv, rid, OpenChannelReq {cert={owner=me}, config=cfg}, applySeal(me,cfg));</layout>
          </ml>
          <ml id="ID20360020">fun trustListToMS ([]:TRUST_ENTRY list) : TRUST_ENTRY ms = empty
  | trustListToMS (x::xs) = 1`x ++ trustListToMS xs;
            <layout>fun trustListToMS ([]:TRUST_ENTRY list) : TRUST_ENTRY ms = empty
  | trustListToMS (x::xs) = 1`x ++ trustListToMS xs;</layout>
          </ml>
        </block>
