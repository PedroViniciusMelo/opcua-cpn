        <ml id="ID20110010">fun forgeReq (src:APP_ID, dst:APP_ID, rid:INT, body:MSG_BODY) : NET_MSG =
  envelope(src, dst, rid, body, NoSeal);

fun weakenEps [] = []
  | weakenEps ({policy,allowedModes}::xs) =
      if policy = POLICY_NONE orelse policyBroken policy
      then {policy=policy, allowedModes=allowedModes} :: weakenEps xs
      else weakenEps xs;

fun forgeEndpoints (m:NET_MSG) : NET_MSG =
  case #body m of
    GetEndpointsResp {endpoints} =&gt;
      envelope(#src m, #dst m, #reqId m,
               GetEndpointsResp {endpoints = weakenEps endpoints}, NoSeal)
  | _ =&gt; m;
          <layout>(* mensagem forjada sem selo (sem SecureChannel valido) -- Parte 2 5.1.4/5.1.9 *)
fun forgeReq (src:APP_ID, dst:APP_ID, rid:INT, body:MSG_BODY) : NET_MSG =
  envelope(src, dst, rid, body, NoSeal);

fun weakenEps [] = []
  | weakenEps ({policy,allowedModes}::xs) =
      if policy = POLICY_NONE orelse policyBroken policy
      then {policy=policy, allowedModes=allowedModes} :: weakenEps xs
      else weakenEps xs;

fun forgeEndpoints (m:NET_MSG) : NET_MSG =
  case #body m of
    GetEndpointsResp {endpoints} =&gt;
      envelope(#src m, #dst m, #reqId m,
               GetEndpointsResp {endpoints = weakenEps endpoints}, NoSeal)
  | _ =&gt; m;</layout>
        </ml>
        <ml id="ID20060101">val MaxCostConfig : SECURITY_CONFIG = CfgAES256Enc;
          <layout>val MaxCostConfig : SECURITY_CONFIG = CfgAES256Enc;
(* reaproveita a constante global -- o atacante so escolhe de proposito a
   politica mais cara pra maximizar o dano por requisicao (Parte 2 5.1.2.2) *)</layout>
        </ml>
      </block>
