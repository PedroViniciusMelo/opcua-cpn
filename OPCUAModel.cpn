          <ml id="ID95000080">(* RolePermissions por Node (Parte 3 5.2.9 Tabela 8), no espirito do exemplo da
   Parte 3 Tabela 4: measurement legivel por todos; setpoint gravavel so pelo
   Operator; o Method chamavel so pelo Operator. Anonymous so navega a estrutura. *)
val rpFolder : ROLE_PERMISSION_LIST =
  [rp(Anonymous, PermBrowse), rp(AuthenticatedUser, PermBrowseRead)];
val rpBoiler : ROLE_PERMISSION_LIST =
  [rp(Anonymous, PermBrowse), rp(AuthenticatedUser, PermBrowseRead),
   rp(Operator, PermBrowseCall)];
(* Call exige o bit Call no Object passado no Call E no Method -- Parte 3 Tabela 38 *)
val rpTemperature : ROLE_PERMISSION_LIST =
  [rp(AuthenticatedUser, PermBrowseRead), rp(Observer, PermBrowseRead),
   rp(Operator, PermBrowseRead)];
val rpSetpoint : ROLE_PERMISSION_LIST =
  [rp(AuthenticatedUser, PermBrowse), rp(Observer, PermBrowse),
   rp(Supervisor, PermBrowseRead), rp(Operator, PermBrowseReadWrite)];
val rpSetSetpoint : ROLE_PERMISSION_LIST =
  [rp(AuthenticatedUser, PermBrowse), rp(Supervisor, PermBrowse),
   rp(Operator, PermBrowseCall)];
            <layout>(* RolePermissions por Node (Parte 3 5.2.9 Tabela 8), no espirito do exemplo da
   Parte 3 Tabela 4: measurement legivel por todos; setpoint gravavel so pelo
   Operator; o Method chamavel so pelo Operator. Anonymous so navega a estrutura. *)
val rpFolder : ROLE_PERMISSION_LIST =
  [rp(Anonymous, PermBrowse), rp(AuthenticatedUser, PermBrowseRead)];
val rpBoiler : ROLE_PERMISSION_LIST =
  [rp(Anonymous, PermBrowse), rp(AuthenticatedUser, PermBrowseRead),
   rp(Operator, PermBrowseCall)];
(* Call exige o bit Call no Object passado no Call E no Method -- Parte 3 Tabela 38 *)
val rpTemperature : ROLE_PERMISSION_LIST =
  [rp(AuthenticatedUser, PermBrowseRead), rp(Observer, PermBrowseRead),
   rp(Operator, PermBrowseRead)];
val rpSetpoint : ROLE_PERMISSION_LIST =
  [rp(AuthenticatedUser, PermBrowse), rp(Observer, PermBrowse),
   rp(Supervisor, PermBrowseRead), rp(Operator, PermBrowseReadWrite)];
val rpSetSetpoint : ROLE_PERMISSION_LIST =
  [rp(AuthenticatedUser, PermBrowse), rp(Supervisor, PermBrowse),
   rp(Operator, PermBrowseCall)];</layout>
          </ml>
          <ml id="ID95000081">val boilerAddressSpace : AS_NODE_LIST =
  [objectNode (ObjectsFolderId, &quot;Objects&quot;, rpFolder, [organizesRef BoilerId]),
   objectNode (BoilerId, &quot;Boiler&quot;, rpBoiler,
               [hasComponentRef TemperatureId, hasComponentRef SetpointId,
                hasComponentRef SetSetpointId]),
   variableNode (TemperatureId, &quot;Temperature&quot;, NoRestrictions, rpTemperature,
                 DT_INT32, VInt32 20, AccessRead, AccessRead),
   variableNode (SetpointId, &quot;Setpoint&quot;, EncryptionRequired, rpSetpoint,
                 DT_INT32, VInt32 50, AccessReadWrite, AccessReadWrite),
   methodNode (SetSetpointId, &quot;SetSetpoint&quot;, SigningRequired, rpSetSetpoint,
               true, true, [DT_INT32], [], SetValueOf SetpointId)];
(* Temperature: so leitura; Setpoint: escrita so em canal cifrado E pelo Operator;
   SetSetpoint: Method componente do Boiler que grava o Setpoint, chamavel pelo Operator *)
            <layout>val boilerAddressSpace : AS_NODE_LIST =
  [objectNode (ObjectsFolderId, &quot;Objects&quot;, rpFolder, [organizesRef BoilerId]),
   objectNode (BoilerId, &quot;Boiler&quot;, rpBoiler,
               [hasComponentRef TemperatureId, hasComponentRef SetpointId,
                hasComponentRef SetSetpointId]),
   variableNode (TemperatureId, &quot;Temperature&quot;, NoRestrictions, rpTemperature,
                 DT_INT32, VInt32 20, AccessRead, AccessRead),
   variableNode (SetpointId, &quot;Setpoint&quot;, EncryptionRequired, rpSetpoint,
                 DT_INT32, VInt32 50, AccessReadWrite, AccessReadWrite),
   methodNode (SetSetpointId, &quot;SetSetpoint&quot;, SigningRequired, rpSetSetpoint,
               true, true, [DT_INT32], [], SetValueOf SetpointId)];
(* Temperature: so leitura; Setpoint: escrita so em canal cifrado E pelo Operator;
   SetSetpoint: Method componente do Boiler que grava o Setpoint, chamavel pelo Operator *)</layout>
          </ml>
          <ml id="ID95000082">(* Mapeamento identidade-de-aplicacao -&gt; Roles (Parte 3 4.9.1). Client1 age como
   Operator; Client2 como Observer (so leitura). Quem nao esta na lista recebe so
   Anonymous (+TrustedApplication em canal assinado) -- least privilege, Parte 2 6.17 *)
val serverRoleMappings : ROLE_MAPPING_LIST =
  [{identity=Client1Id, roles=[AuthenticatedUser, Operator]},
   {identity=Client2Id, roles=[AuthenticatedUser, Observer]},
   {identity=Server2Id, roles=[AuthenticatedUser, Observer]}];
(* Server2 aparece como cliente (nÃÂÃÂÃÂÃÂ³ combinado) ao ler de outro servidor *)
            <layout>(* Mapeamento identidade-de-aplicacao -&gt; Roles (Parte 3 4.9.1). Client1 age como
   Operator; Client2 como Observer (so leitura). Quem nao esta na lista recebe so
   Anonymous (+TrustedApplication em canal assinado) -- least privilege, Parte 2 6.17 *)
val serverRoleMappings : ROLE_MAPPING_LIST =
  [{identity=Client1Id, roles=[AuthenticatedUser, Operator]},
   {identity=Client2Id, roles=[AuthenticatedUser, Observer]},
   {identity=Server2Id, roles=[AuthenticatedUser, Observer]}];
(* Server2 aparece como cliente (nÃÂÃÂÃÂÃÂ³ combinado) ao ler de outro servidor *)</layout>
          </ml>
        </block>
        <block id="ID95000086">
          <id>Planned operations</id>
          <ml id="ID95000084">val client1Operations : PLANNED_OP_LIST =
  [{server=Server1Id, request=BrowseRequest {nodeId=BoilerId, browseDirection=BD_FORWARD,
                                             referenceTypeId=OnlyReferenceType RT_HAS_COMPONENT}},
   {server=Server1Id, request=ReadRequest {nodeId=TemperatureId, attributeId=AT_VALUE}},
   {server=Server1Id, request=WriteRequest {nodeId=TemperatureId, attributeId=AT_VALUE, value=VInt32 99}},
   {server=Server1Id, request=CallRequest {objectId=BoilerId, methodId=SetSetpointId,
                                           inputArguments=[VInt32 70]}}];
(* Client1 = Operator. Browse/Read OK; Write no Temperature -&gt; Bad_NotWritable;
   Call SetSetpoint -&gt; OK (Operator tem Call) *)
            <layout>val client1Operations : PLANNED_OP_LIST =
  [{server=Server1Id, request=BrowseRequest {nodeId=BoilerId, browseDirection=BD_FORWARD,
                                             referenceTypeId=OnlyReferenceType RT_HAS_COMPONENT}},
   {server=Server1Id, request=ReadRequest {nodeId=TemperatureId, attributeId=AT_VALUE}},
   {server=Server1Id, request=WriteRequest {nodeId=TemperatureId, attributeId=AT_VALUE, value=VInt32 99}},
   {server=Server1Id, request=CallRequest {objectId=BoilerId, methodId=SetSetpointId,
                                           inputArguments=[VInt32 70]}}];
(* Client1 = Operator. Browse/Read OK; Write no Temperature -&gt; Bad_NotWritable;
   Call SetSetpoint -&gt; OK (Operator tem Call) *)</layout>
          </ml>
          <ml id="ID95000085">val client2Operations : PLANNED_OP_LIST =
  [{server=Server1Id, request=ReadRequest {nodeId=TemperatureId, attributeId=AT_VALUE}},
   {server=Server1Id, request=WriteRequest {nodeId=SetpointId, attributeId=AT_VALUE, value=VInt32 80}}];
(* Client2 = Observer. Read OK; Write no Setpoint -&gt; Bad_UserAccessDenied (RBAC):
   exemplo de autorizacao por Role / least privilege -- Parte 2 4.2.3, 6.17 *)
            <layout>val client2Operations : PLANNED_OP_LIST =
  [{server=Server1Id, request=ReadRequest {nodeId=TemperatureId, attributeId=AT_VALUE}},
   {server=Server1Id, request=WriteRequest {nodeId=SetpointId, attributeId=AT_VALUE, value=VInt32 80}}];
(* Client2 = Observer. Read OK; Write no Setpoint -&gt; Bad_UserAccessDenied (RBAC):
   exemplo de autorizacao por Role / least privilege -- Parte 2 4.2.3, 6.17 *)</layout>
          </ml>
        </block>
